---
import { getCollection, type CollectionEntry } from 'astro:content';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNavigation from './SiteNavigation.astro';
import SiteBanners from './SiteBanners.astro';
import SiteNotesScript from './SiteNotesScript.astro';
import SiteSection from './SiteSection.astro';
import { getSectionNavigation, getSectionsContent } from '../lib/sectionContent';
import { getRouteTheme } from '../lib/routeThemes';
import { getSitePage, getSitePages } from '../lib/sitePages';
import { getToday, isVisibleToday } from '../lib/visibility';
import { getLogoAsset } from '../lib/sitePublicAssets';
import { readSiteFile } from '../../scripts/lib/site-content.mjs';
import { siteContentPath, siteRoutesDir } from '../../scripts/lib/site-paths.mjs';
import { resolveThemeVisualConfig } from '../../scripts/lib/project-config.mjs';
import { resolveFrameColors, resolvePagePresentation } from '../../scripts/lib/presentation.mjs';

type SiteEntry = CollectionEntry<'site'>;

interface Props {
	entry: SiteEntry;
}

const { entry } = Astro.props;
const siteDirectory = (process.env.NORNA_SITE_DIR ?? 'site').trim();
const sitePages = getSitePages(await getCollection('site'));
const currentPage = getSitePage(entry);
const siteContentLabel = entry.id.includes('-route-')
	? `${siteDirectory || 'site'}/routes/${currentPage.routeDirectory}/content.md`
	: `${siteDirectory || 'site'}/content.md`;
const pageContentPath = currentPage.routeDirectory
	? path.join(siteRoutesDir, currentPage.routeDirectory, 'content.md')
	: siteContentPath;
const rawMarkdown = (await readSiteFile(pageContentPath, siteContentLabel)).body;
const [siteTheme] = await getCollection('theme');
if (!siteTheme) {
	throw new Error('site/theme.yaml is required. Add a root theme before building the site.');
}
const [sitewide] = await getCollection('sitewide');
const sitewideData = sitewide?.data ?? {};
const homePage = sitePages.find((page) => page.isHome) ?? currentPage;
const siteThemeData = siteTheme.data;
const routeTheme = await getRouteTheme(currentPage.routeDirectory);
const themeData = routeTheme?.data ?? siteThemeData;
const themeLabel = routeTheme
	? `${siteDirectory || 'site'}/${routeTheme.id}`
	: `${siteDirectory || 'site'}/${siteTheme.id}`;
const visualTheme = resolveThemeVisualConfig(themeData, themeLabel);
const logoAsset = getLogoAsset();
const logoSettings = sitewideData.logo;
const logo = logoAsset
	? {
		src: logoAsset.href,
		alt: homePage.title,
		height: logoSettings?.height,
	}
	: undefined;
const pagePresentation = resolvePagePresentation(themeData, themeLabel);
const frameColors = resolveFrameColors({ theme: themeData, sourceLabel: themeLabel });
const siteHtml = entry.rendered?.html ?? '';
const resolvedSections = await getSectionsContent(siteHtml, rawMarkdown, currentPage);
const today = getToday();
const siteBanners = (sitewideData.banners ?? []).filter((banner) => isVisibleToday(banner.visible, today));
const hasMarginNotes = resolvedSections.some((section) => section.contentBlocks.some((block) => block.type === 'note'));

const getPageContent = async (page: SitePage) => {
	if (page.pathname === currentPage.pathname) {
		return resolvedSections.map(({ id, title }) => ({ id, title }));
	}

	return getSectionNavigation(page.entry.rendered?.html ?? '');
};

const pageNavigation = await Promise.all(sitePages.map(async (page) => ({
	page,
	sections: await getPageContent(page),
})));

---

<BaseLayout
	title={entry.data.page.title}
	description={entry.data.page.description}
	presentation={pagePresentation}
	visualTheme={visualTheme}
	frameColors={frameColors}
	pathname={currentPage.pathname}
	footer={sitewideData.footer}
>
	<SiteNavigation
		logo={logo}
		currentPage={currentPage}
		pageNavigation={pageNavigation}
		frameColors={frameColors}
	/>
	{siteBanners.length > 0 && <SiteBanners banners={siteBanners} />}

	<main id="main-content" class="site-content">
		{resolvedSections.map((section, index) => (
			<SiteSection
				section={section}
				pagePresentation={pagePresentation}
				visualTheme={visualTheme}
				sectionIndex={index}
				headingLevel={index === 0 ? 1 : 2}
				prioritizeFirstImage={index === 0}
			/>
		))}
	</main>
	{hasMarginNotes && <SiteNotesScript />}
</BaseLayout>
