---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlockCopyScript from './CodeBlockCopyScript.astro';
import SiteBreadcrumbs from './SiteBreadcrumbs.astro';
import SiteNavigation from './SiteNavigation.astro';
import SiteBanners from './SiteBanners.astro';
import PageContentsNavigation from './PageContentsNavigation.astro';
import SiteSection from './SiteSection.astro';
import SiteTreeNavigation from './SiteTreeNavigation.astro';
import TreeNavigationScript from './TreeNavigationScript.astro';
import { getSectionsContent, type ResolvedSection } from '../lib/sectionContent';
import { getPageTheme } from '../lib/pageThemes';
import { getSiteModel, type SitePage } from '../lib/sitePages';
import { flattenSiteNavigationTree, getListedSiteNavigationTree } from '../lib/siteNavigation';
import { getToday, isVisibleToday } from '../lib/visibility';
import { getLogoAsset } from '../lib/sitePublicAssets';
import { resolveNavigationModel } from '../../scripts/lib/navigation-model.mjs';
import { projectConfig, resolveThemeVisualConfig } from '../../scripts/lib/project-config.mjs';
import { getTextWidthCssValue, resolveFrameColors, resolvePagePresentation } from '../../scripts/lib/presentation.mjs';
import { mergePageThemeConfig } from '../../scripts/lib/theme-presets.mjs';

type SiteEntry = CollectionEntry<'site'>;

interface Props {
	entry: SiteEntry;
}

const { entry } = Astro.props;
const siteDirectory = (process.env.NORNA_SITE_DIR ?? 'site').trim();
const siteModel = await getSiteModel(await getCollection('site'));
const { nodes: siteNodes, pages: sitePages } = siteModel;
const currentPage = sitePages.find((page) => page.entry.id === entry.id);
if (!currentPage) throw new Error(`Page entry "${entry.id}" is missing from the site page model.`);
const [siteTheme] = await getCollection('theme');
if (!siteTheme) {
	throw new Error('site/theme.yaml is required. Add a root theme before building the site.');
}
const [sitewide] = await getCollection('sitewide');
const sitewideData = sitewide?.data ?? {};
const homePage = sitePages.find((page) => page.isHome) ?? currentPage;
const siteThemeData = siteTheme.data;
const pageTheme = await getPageTheme(currentPage.pageDirectory);
const themeData = mergePageThemeConfig(siteThemeData, pageTheme?.data);
const themeLabel = pageTheme
	? `${siteDirectory || 'site'}/${pageTheme.id}`
	: `${siteDirectory || 'site'}/${siteTheme.id}`;
const visualTheme = resolveThemeVisualConfig(themeData, themeLabel);
const logoAsset = getLogoAsset();
const logoSettings = sitewideData.logo;
const logo = logoAsset
	? {
		src: logoAsset.href,
		alt: homePage.title,
		height: logoSettings?.height,
	}
	: undefined;
const siteHtml = entry.rendered?.html ?? '';
const resolvedSections = await getSectionsContent(siteHtml, currentPage);
const hasCodeBlocks = resolvedSections.some((section) => section.contentBlocks.some((block) => (
	block.type === 'html' && /<pre\b[^>]*>[\s\S]*?<code\b/i.test(block.html)
)));
const today = getToday();
const siteBanners = (sitewideData.banners ?? []).filter((banner) => isVisibleToday(banner.visible, today));
const hasPrioritizableImage = (section: ResolvedSection) => section.contentBlocks.some((block) => (
	block.type === 'image-stack'
	|| block.type === 'image-carousel'
));
const firstImageSectionIndex = resolvedSections.findIndex(hasPrioritizableImage);
let contentSectionIndex = 0;
const renderedSections = resolvedSections.map((section, index) => ({
	section,
	sectionIndex: section.headingLevel === 1 ? 0 : contentSectionIndex++,
	prioritizeFirstImage: index === firstImageSectionIndex,
}));

const getPageContent = (page: SitePage) =>
	page.markdownDocument.navigationHeadings.map(({ depth, id, parentId, title }) => ({
		depth,
		id,
		parentId,
		title,
	}));

const siteNavigation = siteNodes.map((node) => {
	const headings = node.kind === 'page' ? getPageContent(node) : [];
	return {
		node,
		headings,
		sections: headings
			.filter((heading) => heading.depth === 2)
			.map(({ id, title }) => ({ id, title })),
	};
});
const renderedNavigationEntries = flattenSiteNavigationTree(getListedSiteNavigationTree(siteNavigation));
const navigationModel = resolveNavigationModel({
	mode: projectConfig.navigation.mode,
	nodes: renderedNavigationEntries.map(({ node, headings }) => ({
		depth: Math.max(1, node.depth),
		headings,
		isHome: node.isHome,
		kind: node.kind,
		listed: node.navigation.listed,
		pagePath: node.pagePath,
	})),
	currentPage: {
		isHome: currentPage.isHome,
		pagePath: currentPage.pagePath,
	},
});
const pagePresentation = resolvePagePresentation(themeData, themeLabel, {
	navigationMode: navigationModel.mode,
});
const pageTextWidth = getTextWidthCssValue(pagePresentation.typography.values.body.width);
const frameColors = resolveFrameColors({ theme: siteThemeData, sourceLabel: `${siteDirectory || 'site'}/${siteTheme.id}` });
const hasTreeNavigation = navigationModel.mode === 'tree';
const currentPageNavigation = siteNavigation.find(({ node }) => (
	node.kind === 'page' && node.pathname === currentPage.pathname
));
const pageContentsHeadings = currentPageNavigation?.headings.filter(({ depth }) => depth === 2 || depth === 3) ?? [];
const hasContentsNavigation = hasTreeNavigation && pageContentsHeadings.length > 1;
const hasNavigationRailFrame = navigationModel.requestedMode === 'tree'
	|| (
		navigationModel.requestedMode === 'automatic'
		&& (navigationModel.hasNestedPages || navigationModel.hasCategories)
	);
const showBreadcrumbs = !currentPage.isHome && currentPage.parentPagePath !== null;
const reserveBreadcrumbSpace = hasTreeNavigation || showBreadcrumbs;

---

<BaseLayout
	title={currentPage.title}
	description={entry.data.page?.description}
	presentation={pagePresentation}
	visualTheme={visualTheme}
	frameColors={frameColors}
	pathname={currentPage.pathname}
	footer={sitewideData.footer}
	contentsNavigation={hasContentsNavigation}
>
	<SiteNavigation
		logo={logo}
		currentPage={currentPage}
		navigationEntries={siteNavigation}
		navigationMode={navigationModel.mode}
		showTopNavigationSubmenus={navigationModel.requestedMode !== 'automatic' && navigationModel.mode !== 'tree'}
		hasNavigationRailFrame={hasNavigationRailFrame}
		frameColors={frameColors}
		readerPreferences={pagePresentation.readerPreferences}
	/>
	{siteBanners.length > 0 && <SiteBanners banners={siteBanners} />}

	<div class:list={['site-page-layout', {
		'site-page-layout-tree': hasTreeNavigation,
		'site-page-layout-contents': hasContentsNavigation,
	}]}>
		{hasTreeNavigation && (
			<SiteTreeNavigation currentPage={currentPage} navigationEntries={siteNavigation} />
		)}
		<main
			class:list={['site-content', { 'site-content-has-breadcrumbs': reserveBreadcrumbSpace }]}
			id="main-content"
			style={`--page-text-width: ${pageTextWidth}`}
		>
			{showBreadcrumbs
				? <SiteBreadcrumbs currentPage={currentPage} nodes={siteNodes} />
				: reserveBreadcrumbSpace && <div class="site-breadcrumbs" aria-hidden="true"></div>}
			{hasContentsNavigation && (
				<PageContentsNavigation
					headings={pageContentsHeadings}
					pageTitle={currentPage.title}
					variant="inline"
				/>
			)}
			{renderedSections.map(({ section, sectionIndex, prioritizeFirstImage }) => (
				<SiteSection
					section={section}
					pagePresentation={pagePresentation}
					visualTheme={visualTheme}
					sectionIndex={sectionIndex}
					prioritizeFirstImage={prioritizeFirstImage}
				/>
			))}
		</main>
		{hasContentsNavigation && (
			<PageContentsNavigation
				headings={pageContentsHeadings}
				pageTitle={currentPage.title}
				variant="rail"
			/>
		)}
	</div>
	{hasTreeNavigation && <TreeNavigationScript />}
	{hasCodeBlocks && <CodeBlockCopyScript />}
</BaseLayout>
