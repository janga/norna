---
import { getCollection, type CollectionEntry } from 'astro:content';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteBreadcrumbs from './SiteBreadcrumbs.astro';
import SiteNavigation from './SiteNavigation.astro';
import SiteBanners from './SiteBanners.astro';
import SiteNotesScript from './SiteNotesScript.astro';
import SiteSection from './SiteSection.astro';
import { getHeadingNavigation, getSectionsContent, type ResolvedSection } from '../lib/sectionContent';
import { getPageTheme } from '../lib/pageThemes';
import { getSitePage, getSitePages, type SitePage } from '../lib/sitePages';
import { getToday, isVisibleToday } from '../lib/visibility';
import { getLogoAsset } from '../lib/sitePublicAssets';
import { readSiteFile } from '../../scripts/lib/site-content.mjs';
import { resolveNavigationModel } from '../../scripts/lib/navigation-model.mjs';
import { siteContentPath, sitePagesDir } from '../../scripts/lib/site-paths.mjs';
import { projectConfig, resolveThemeVisualConfig } from '../../scripts/lib/project-config.mjs';
import { resolveFrameColors, resolvePagePresentation } from '../../scripts/lib/presentation.mjs';

type SiteEntry = CollectionEntry<'site'>;

interface Props {
	entry: SiteEntry;
}

const { entry } = Astro.props;
const siteDirectory = (process.env.NORNA_SITE_DIR ?? 'site').trim();
const sitePages = getSitePages(await getCollection('site'));
const currentPage = getSitePage(entry);
const getPageContentFile = (page: SitePage) => page.pageDirectory
	? {
		label: `${siteDirectory || 'site'}/pages/${page.pageDirectory}/content.md`,
		path: path.join(sitePagesDir, page.pageDirectory, 'content.md'),
	}
	: {
		label: `${siteDirectory || 'site'}/content.md`,
		path: siteContentPath,
	};
const pageContentFile = getPageContentFile(currentPage);
const siteContentLabel = pageContentFile.label;
const rawMarkdown = (await readSiteFile(pageContentFile.path, pageContentFile.label)).body;
const [siteTheme] = await getCollection('theme');
if (!siteTheme) {
	throw new Error('site/theme.yaml is required. Add a root theme before building the site.');
}
const [sitewide] = await getCollection('sitewide');
const sitewideData = sitewide?.data ?? {};
const homePage = sitePages.find((page) => page.isHome) ?? currentPage;
const siteThemeData = siteTheme.data;
const pageTheme = await getPageTheme(currentPage.pageDirectory);
const themeData = pageTheme?.data ?? siteThemeData;
const themeLabel = pageTheme
	? `${siteDirectory || 'site'}/${pageTheme.id}`
	: `${siteDirectory || 'site'}/${siteTheme.id}`;
const visualTheme = resolveThemeVisualConfig(themeData, themeLabel);
const logoAsset = getLogoAsset();
const logoSettings = sitewideData.logo;
const logo = logoAsset
	? {
		src: logoAsset.href,
		alt: homePage.title,
		height: logoSettings?.height,
	}
	: undefined;
const pagePresentation = resolvePagePresentation(themeData, themeLabel);
const frameColors = resolveFrameColors({ theme: themeData, sourceLabel: themeLabel });
const siteHtml = entry.rendered?.html ?? '';
const resolvedSections = await getSectionsContent(siteHtml, rawMarkdown, currentPage, siteContentLabel);
const today = getToday();
const siteBanners = (sitewideData.banners ?? []).filter((banner) => isVisibleToday(banner.visible, today));
const hasMarginNotes = resolvedSections.some((section) => section.contentBlocks.some((block) => block.type === 'note'));
const hasPrioritizableImage = (section: ResolvedSection) => section.contentBlocks.some((block) => (
	block.type === 'image-stack'
	|| block.type === 'image-carousel'
));
const firstImageSectionIndex = resolvedSections.findIndex(hasPrioritizableImage);
let contentSectionIndex = 0;
const renderedSections = resolvedSections.map((section, index) => ({
	section,
	sectionIndex: section.headingLevel === 1 ? 0 : contentSectionIndex++,
	prioritizeFirstImage: index === firstImageSectionIndex,
}));

const getPageContent = async (page: SitePage) => {
	const contentFile = getPageContentFile(page);
	const pageMarkdown = page.pathname === currentPage.pathname
		? rawMarkdown
		: (await readSiteFile(contentFile.path, contentFile.label)).body;
	return getHeadingNavigation(pageMarkdown, contentFile.label);
};

const pageNavigation = await Promise.all(sitePages.map(async (page) => {
	const headings = await getPageContent(page);
	return {
		page,
		headings,
		sections: headings
			.filter((heading) => heading.depth === 2)
			.map(({ id, title }) => ({ id, title })),
	};
}));
const navigationModel = resolveNavigationModel({
	mode: projectConfig.navigation.mode,
	pages: pageNavigation.map(({ page, headings }) => ({
		depth: Math.max(1, page.depth),
		headings,
		isHome: page.isHome,
		listed: page.navigation.listed,
	})),
});

---

<BaseLayout
	title={currentPage.title}
	description={entry.data.page?.description}
	presentation={pagePresentation}
	visualTheme={visualTheme}
	frameColors={frameColors}
	pathname={currentPage.pathname}
	footer={sitewideData.footer}
>
	<SiteNavigation
		logo={logo}
		currentPage={currentPage}
		pageNavigation={pageNavigation}
		navigationMode={navigationModel.mode}
		frameColors={frameColors}
	/>
	{siteBanners.length > 0 && <SiteBanners banners={siteBanners} />}

	<main class:list={['site-content', { 'site-content-has-breadcrumbs': currentPage.depth > 1 }]} id="main-content">
		{currentPage.depth > 1 && <SiteBreadcrumbs currentPage={currentPage} pages={sitePages} />}
		{renderedSections.map(({ section, sectionIndex, prioritizeFirstImage }) => (
			<SiteSection
				section={section}
				pagePresentation={pagePresentation}
				visualTheme={visualTheme}
				sectionIndex={sectionIndex}
				prioritizeFirstImage={prioritizeFirstImage}
			/>
		))}
	</main>
	{hasMarginNotes && <SiteNotesScript />}
</BaseLayout>
