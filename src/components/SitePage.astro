---
import { getCollection, type CollectionEntry } from 'astro:content';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNavigation from './SiteNavigation.astro';
import SiteBanners from './SiteBanners.astro';
import SiteSection from './SiteSection.astro';
import { getSectionNavigation, getSectionsContent } from '../lib/sectionContent';
import { getNavigationPages, getSitePage, getSitePages } from '../lib/sitePages';
import { getToday, isVisibleToday } from '../lib/visibility';
import { getLogoAsset } from '../lib/sitePublicAssets';
import { readSiteFile } from '../../scripts/lib/site-content.mjs';
import { siteContentPath, siteRoutesDir } from '../../scripts/lib/site-paths.mjs';
import { resolveFrameColors, resolvePagePresentation } from '../../scripts/lib/presentation.mjs';

type SiteEntry = CollectionEntry<'site'>;

interface Props {
	entry: SiteEntry;
}

const { entry } = Astro.props;
const siteDirectory = (process.env.NORNA_SITE_DIR ?? 'site').trim();
const sitePages = getSitePages(await getCollection('site'));
const currentPage = getSitePage(entry);
const siteContentLabel = entry.id.includes('-route-')
	? `${siteDirectory || 'site'}/routes/${currentPage.routeDirectory}/route-content.md`
	: `${siteDirectory || 'site'}/content.md`;
const pageContentPath = currentPage.routeDirectory
	? path.join(siteRoutesDir, currentPage.routeDirectory, 'route-content.md')
	: siteContentPath;
const rawMarkdown = (await readSiteFile(pageContentPath, siteContentLabel)).body;
const [theme] = await getCollection('theme');
const [sitewide] = await getCollection('sitewide');
const navigationPages = getNavigationPages(sitePages);
const homePage = sitePages.find((page) => page.isHome) ?? currentPage;
const themeData = theme?.data ?? {};
const brandLabel = themeData.navigation?.brand ?? homePage.title;
const logoAsset = getLogoAsset();
const logoSettings = themeData.navigation?.logo;
const logo = logoAsset
	? {
		src: logoAsset.href,
		alt: logoSettings?.alt ?? brandLabel,
		height: logoSettings?.height,
	}
	: undefined;
const pagePresentation = resolvePagePresentation(themeData, entry.data.presentation);
const frameColors = resolveFrameColors({ theme: themeData });
const sections = entry.data.sections;
const siteHtml = entry.rendered?.html ?? '';
const resolvedSections = getSectionsContent(siteHtml, rawMarkdown, sections, currentPage);
const today = getToday();
const sitewideData = sitewide?.data ?? {};
const siteBanners = (sitewideData.banners ?? []).filter((banner) => isVisibleToday(banner.visible, today));
const visibleSections = resolvedSections.filter((section) => isVisibleToday(section.visible, today));

const getPageContent = async (page: SitePage) => {
	if (page.pathname === currentPage.pathname) {
		return visibleSections.map(({ id, title }) => ({ id, title }));
	}

	const pageSections = getSectionNavigation(page.entry.rendered?.html ?? '', page.entry.data.sections);

	return pageSections.filter((section) => isVisibleToday(page.entry.data.sections[section.id]?.visible, today));
};

const pageNavigation = await Promise.all(navigationPages.map(async (page) => ({
	page,
	sections: await getPageContent(page),
})));

if (visibleSections.length === 0) {
	throw new Error(`No sections are visible for ${today}. Check sections.<section-id>.visible in ${siteContentLabel}.`);
}
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	presentation={pagePresentation}
	frameColors={frameColors}
	pathname={currentPage.pathname}
	footer={sitewideData.footer}
>
	<SiteNavigation
		brandLabel={brandLabel}
		logo={logo}
		currentPage={currentPage}
		pageNavigation={pageNavigation}
		frameColors={frameColors}
	/>
	<SiteBanners banners={siteBanners} />

	<main id="main-content" class="site-content">
		{visibleSections.map((section, index) => (
			<SiteSection
				section={section}
				pagePresentation={pagePresentation}
				sectionIndex={index}
				headingLevel={index === 0 ? 1 : 2}
				priorityGalleryImage={index === 0}
			/>
		))}
	</main>
</BaseLayout>
