---
import { navigationPrototype as enabled } from '../lib/navigationPrototypeConfig.mjs';
import { getNavigationStateScript } from '../lib/navigationStateScript.mjs';

interface Props {
	scope: 'desktop' | 'mobile';
}

const { scope } = Astro.props;
---

{enabled && (
	<script is:inline data-navigation-state-scope={scope} set:html={getNavigationStateScript()} />
)}
