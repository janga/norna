---
import projectConfig from '../../scripts/lib/project-config.mjs';
import { withBasePath } from '../lib/basePath';
import type { SiteNode, SitePage } from '../lib/sitePages';

interface Props {
	currentPage: SitePage;
	nodes: SiteNode[];
}

const { currentPage, nodes } = Astro.props;
const nodesByPath = new Map(nodes.map((node) => [node.pagePath, node]));
const ancestors: SiteNode[] = [];
let parentPagePath = currentPage.parentPagePath;
while (parentPagePath !== null) {
	const parentNode = nodesByPath.get(parentPagePath);
	if (!parentNode) break;
	ancestors.unshift(parentNode);
	parentPagePath = parentNode.parentPagePath;
}
const pageHref = (page: SitePage) => withBasePath(projectConfig.site.basePath, page.pathname);
---

<nav class="site-breadcrumbs" aria-label={projectConfig.locale.labels.breadcrumb}>
	<ol>
		{ancestors.map((node) => (
			<li>
				{node.kind === 'page'
					? <a href={pageHref(node)}>{node.title}</a>
					: <span>{node.title}</span>}
			</li>
		))}
		<li><span aria-current="page">{currentPage.title}</span></li>
	</ol>
</nav>
