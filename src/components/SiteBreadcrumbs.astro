---
import projectConfig from '../../scripts/lib/project-config.mjs';
import { withBasePath } from '../lib/basePath';
import type { SitePage } from '../lib/sitePages';

interface Props {
	currentPage: SitePage;
	pages: SitePage[];
}

const { currentPage, pages } = Astro.props;
const pagesByPath = new Map(pages.map((page) => [page.pagePath, page]));
const ancestors: SitePage[] = [];
let parentPagePath = currentPage.parentPagePath;
while (parentPagePath !== null) {
	const parentPage = pagesByPath.get(parentPagePath);
	if (!parentPage) break;
	ancestors.unshift(parentPage);
	parentPagePath = parentPage.parentPagePath;
}
const pageHref = (page: SitePage) => withBasePath(projectConfig.site.basePath, page.pathname);
const breadcrumbPages = ancestors;
---

<nav class="site-breadcrumbs" aria-label={projectConfig.locale.labels.breadcrumb}>
	<ol>
		{breadcrumbPages.map((page) => (
			<li><a href={pageHref(page)}>{page.title}</a></li>
		))}
		<li><span aria-current="page">{currentPage.title}</span></li>
	</ol>
</nav>
