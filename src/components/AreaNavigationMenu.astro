---
import projectConfig from '../../scripts/lib/project-config.mjs';
import type { CategoryDestinationMap, SiteNavigationNode } from '../lib/siteNavigation';
import type { SiteNode } from '../lib/sitePages';
import AreaNavigationPanel from './AreaNavigationPanel.astro';

interface Props {
	node: SiteNavigationNode;
	currentPage?: SiteNode;
	categoryDestinations?: CategoryDestinationMap;
}
const { node, currentPage, categoryDestinations } = Astro.props;
const label = `${projectConfig.locale.labels.navigationMenu}: ${node.node.title}`;
const panelId = `area-menu-${encodeURIComponent(node.node.pagePath)}`;
---

{node.children.length > 0 && (
	<details class="top-page-menu area-navigation-menu" data-area-menu={node.node.pagePath}>
		<summary aria-label={label} aria-controls={panelId}>
			<span class="top-page-menu-title">{node.node.title}</span>
		</summary>
		<AreaNavigationPanel id={panelId} node={node} currentPage={currentPage} categoryDestinations={categoryDestinations} />
	</details>
)}
