---
import type { CollectionEntry } from 'astro:content';

type SiteNotice = CollectionEntry<'site'>['data']['notices'][number];
type SiteDefaultPresentation = CollectionEntry<'site'>['data']['defaultPresentation'];

interface Props {
	notices: SiteNotice[];
	defaultPresentation?: SiteDefaultPresentation;
}

const { notices, defaultPresentation: configuredDefaultPresentation } = Astro.props;
const noticeStyle = [
	`--site-notice-background-color: ${configuredDefaultPresentation?.backgroundColor ?? 'var(--color-surface)'}`,
	`--site-notice-text-color: ${configuredDefaultPresentation?.textColor ?? 'var(--color-text)'}`,
].join('; ');
---

{notices.length > 0 && (
	<aside class="site-notices" aria-label="Aktuellt" style={noticeStyle}>
		<div class="site-notices-inner">
			{notices.map((notice) => (
				<a class="site-notice" href={notice.href}>
					<span class="site-notice-kicker">Aktuellt</span>
					<span class="site-notice-content">
						<strong>{notice.title}</strong>
						{notice.text && <span>{notice.text}</span>}
					</span>
				</a>
			))}
		</div>
	</aside>
)}
