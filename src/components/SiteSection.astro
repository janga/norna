---
import { getTextWidthCssValue, resolveSectionSurface } from '../../scripts/lib/presentation.mjs';
import {
	bodyTypographySizeValues,
	captionTypographySizeValues,
	getHeadingTypographySizeValue,
	getTypographySizeValue,
} from '../../scripts/lib/typography.mjs';
import CardList from './CardList.astro';
import ImageCarousel from './ImageCarousel.astro';
import ImageStack from './ImageStack.astro';
import type { ResolvedSection } from '../lib/sectionContent';

type ResponsiveValue<T> = { desktop: T; mobile: T };
type ResponsiveOverride<T> = { desktop?: T; mobile?: T };
type TextAlign = 'left' | 'center' | 'right';
type TextSize = 'small' | 'medium' | 'large' | 'xlarge';
type TextWidth = 'narrow' | 'normal' | 'wide';
type ResolvedPagePresentation = {
	blocks: {
		cardList: {
			width: 'text' | 'narrow' | 'normal' | 'wide';
		};
	};
	palette: {
		surfaces: Record<'base' | 'soft' | 'emphasis', { backgroundColor: string; textColor: string }>;
	};
	sectionSurfaces: Array<'base' | 'soft' | 'emphasis'>;
	typography: {
		profile: string;
		values: any;
	};
};
type VisualTheme = {
	images: {
		presentation: 'prose-aligned' | 'centered-fit';
		maxAvailableWidthPercent: {
			desktop: number;
			mobile: number;
		};
		maxAvailableHeightPercent?: {
			desktop: number;
			mobile: number;
		};
	};
};

interface Props {
	section: ResolvedSection;
	pagePresentation: ResolvedPagePresentation;
	visualTheme: VisualTheme;
	sectionIndex: number;
	prioritizeFirstImage?: boolean;
}

const { section, pagePresentation, visualTheme, sectionIndex, prioritizeFirstImage = false } = Astro.props;
const isPageTitle = section.headingLevel === 1;
const HeadingTag = section.headingLevel === 1 ? 'h1' : 'h2';
const sectionHeadingVisualLevel = section.headingLevel === 1 ? 'h1' : 'h2';
const headingId = section.id ?? 'page-title';
const firstContentBlock = section.contentBlocks[0];
const firstContentBlockIsVisual = firstContentBlock !== undefined
	&& firstContentBlock.type !== 'html';
const surface = isPageTitle
	? {
		backgroundColor: 'var(--color-surface-base-background)',
		textColor: 'var(--color-surface-base-text)',
		secondaryTextColor: 'var(--color-surface-base-secondary-text)',
	}
	: resolveSectionSurface(pagePresentation, sectionIndex);
const typography = pagePresentation.typography.values;
const heading = typography.headings[sectionHeadingVisualLevel] as {
	align: ResponsiveValue<TextAlign>;
	size: TextSize;
	weight: number;
	lineHeight: number;
	spacingBefore: string;
	spacingAfter: string;
};
const markdownHeadingLevels = ['h3', 'h4'] as const;
const markdownHeadings = Object.fromEntries(markdownHeadingLevels.map((level) => [
	level,
	typography.headings[level] as {
		align: ResponsiveValue<TextAlign>;
		size: TextSize;
		weight: number;
		lineHeight: number;
		spacingBefore: string;
		spacingAfter: string;
	},
]));
const headingAlign = heading.align;
const bodyAlign = typography.body.align as ResponsiveValue<TextAlign>;
const captionAlign = typography.caption.align as ResponsiveValue<TextAlign>;
const headingFontSize = getHeadingTypographySizeValue(sectionHeadingVisualLevel, heading.size);
const bodyFontSize = getTypographySizeValue(bodyTypographySizeValues, typography.body.size as TextSize);
const captionFontSize = getTypographySizeValue(captionTypographySizeValues, typography.caption.size as TextSize);
const justifyByAlign: Record<TextAlign, string> = {
	left: 'flex-start',
	center: 'center',
	right: 'flex-end',
};
const bodyWidthValue = getTextWidthCssValue(typography.body.width as TextWidth);
const headingWidth = {
	desktop: bodyWidthValue,
	mobile: bodyWidthValue,
};
const bodyWidth = {
	desktop: bodyWidthValue,
	mobile: bodyWidthValue,
};
const isStructuredBlock = (block: ResolvedSection['contentBlocks'][number]) => (
	block.type === 'image-stack'
	|| block.type === 'image-carousel'
	|| block.type === 'card-list'
);
const hasMedia = section.contentBlocks.some((block) => (
	block.type === 'image-stack'
	|| block.type === 'image-carousel'
	|| (block.type === 'card-list' && block.cards.some((card) => card.image))
));
const contentGroups: Array<
	| { type: 'reading'; blocks: ResolvedSection['contentBlocks'] }
	| { type: 'media'; block: Extract<ResolvedSection['contentBlocks'][number], { type: 'image-stack' | 'image-carousel' | 'card-list' }> }
> = [];
let readingBlocks: ResolvedSection['contentBlocks'] = [];
const flushReadingBlocks = () => {
	if (readingBlocks.length === 0) return;
	contentGroups.push({ type: 'reading', blocks: readingBlocks });
	readingBlocks = [];
};

for (const block of section.contentBlocks) {
	if (isStructuredBlock(block)) {
		flushReadingBlocks();
		contentGroups.push({ type: 'media', block });
	} else {
		readingBlocks = [...readingBlocks, block];
	}
}

flushReadingBlocks();
const firstMediaGroupIndex = contentGroups.findIndex((group) => group.type === 'media');
const markdownHeadingStyle = (level: 'h3' | 'h4') => {
	const headingConfig = markdownHeadings[level];
	const fontSize = getHeadingTypographySizeValue(level, headingConfig.size);

	return [
		`--section-markdown-${level}-align-desktop: ${headingConfig.align.desktop}`,
		`--section-markdown-${level}-align-mobile: ${headingConfig.align.mobile}`,
		`--section-markdown-${level}-font-size-desktop: ${fontSize.desktop}`,
		`--section-markdown-${level}-font-size-mobile: ${fontSize.mobile}`,
		`--section-markdown-${level}-font-weight: ${headingConfig.weight}`,
		`--section-markdown-${level}-line-height: ${headingConfig.lineHeight}`,
		`--section-markdown-${level}-spacing-before: ${headingConfig.spacingBefore}`,
		`--section-markdown-${level}-spacing-after: ${headingConfig.spacingAfter}`,
	];
};
const sectionStyle = [
	`--section-background-color: ${surface.backgroundColor}`,
	`--section-text-color: ${surface.textColor}`,
	`--section-secondary-text-color: ${surface.secondaryTextColor}`,
	`--section-heading-align-desktop: ${headingAlign.desktop}`,
	`--section-heading-align-mobile: ${headingAlign.mobile}`,
	`--section-heading-font-size-desktop: ${headingFontSize.desktop}`,
	`--section-heading-font-size-mobile: ${headingFontSize.mobile}`,
	`--section-heading-font-weight: ${heading.weight}`,
	`--section-heading-line-height: ${heading.lineHeight}`,
	`--section-heading-spacing-after: ${heading.spacingAfter}`,
	`--section-heading-width-desktop: ${headingWidth.desktop}`,
	`--section-heading-width-mobile: ${headingWidth.mobile}`,
	...markdownHeadingStyle('h3'),
	...markdownHeadingStyle('h4'),
	`--section-body-align-desktop: ${bodyAlign.desktop}`,
	`--section-body-align-mobile: ${bodyAlign.mobile}`,
	`--section-body-font-size-desktop: ${bodyFontSize.desktop}`,
	`--section-body-font-size-mobile: ${bodyFontSize.mobile}`,
	`--section-body-line-height: ${typography.body.lineHeight}`,
	`--section-body-paragraph-spacing: ${typography.body.paragraphSpacing}`,
	`--section-body-width-desktop: ${bodyWidth.desktop}`,
	`--section-body-width-mobile: ${bodyWidth.mobile}`,
	`--section-caption-align-desktop: ${captionAlign.desktop}`,
	`--section-caption-align-mobile: ${captionAlign.mobile}`,
	`--section-caption-font-size-desktop: ${captionFontSize.desktop}`,
	`--section-caption-font-size-mobile: ${captionFontSize.mobile}`,
	`--section-caption-line-height: ${typography.caption.lineHeight}`,
	`--section-caption-spacing-before: ${typography.caption.spacingBefore}`,
	`--section-caption-justify-desktop: ${justifyByAlign[captionAlign.desktop]}`,
	`--section-caption-justify-mobile: ${justifyByAlign[captionAlign.mobile]}`,
].join('; ');
---

<section
	aria-labelledby={headingId}
	class:list={[
		'site-section',
		{
			'site-section-page-title': isPageTitle,
			'site-section-page-title-empty': isPageTitle && section.contentBlocks.length === 0,
			'site-section-first-block-is-visual': firstContentBlockIsVisual,
		},
	]}
	data-section-title={section.title}
	style={sectionStyle}
>
	<div class="section-card">
		<header class="section-header">
			<HeadingTag id={headingId} set:html={section.titleHtml} />
		</header>

		<div class:list={['section-body', { 'section-body-has-media': hasMedia, 'section-body-text-only': !hasMedia }]}>
			{contentGroups.map((group, groupIndex) => {
				if (group.type === 'reading') {
					return group.blocks.map((block) => block.type === 'html'
						&& block.html
						&& <div class="section-markdown" set:html={block.html} />);
				}

				const block = group.block;
				if (block.type === 'image-carousel') {
					return (
						<ImageCarousel
							title={section.title}
							images={block.images}
							maxAvailableWidthPercent={visualTheme.images.maxAvailableWidthPercent}
							maxAvailableHeightPercent={visualTheme.images.maxAvailableHeightPercent}
							priorityFirstImage={prioritizeFirstImage && groupIndex === firstMediaGroupIndex}
						/>
					);
				}

				if (block.type === 'card-list') {
					return (
						<CardList
							cards={block.cards}
							layout={block.layout}
							flow={block.flow}
							size={block.size}
							width={block.width ?? pagePresentation.blocks.cardList.width}
						/>
					);
				}

				return (
					<ImageStack
						title={section.title}
						images={block.images}
						maxAvailableWidthPercent={visualTheme.images.maxAvailableWidthPercent}
						priorityFirstImage={prioritizeFirstImage && groupIndex === firstMediaGroupIndex}
					/>
				);
			})}
		</div>
	</div>
</section>
