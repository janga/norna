---
import projectConfig from '../../scripts/lib/project-config.mjs';
import { getImageAttributes } from '../lib/generatedImages';
import {
	getCaptionId,
	getCarouselAspectRatio,
	getManagedImageSizes,
	getImageClass,
	getImageLoadingProps,
	type ManagedImage,
} from '../lib/imagePresentation';

interface Props {
	title: string;
	images: ManagedImage[];
	maxAvailableWidthPercent: {
		desktop: number;
		mobile: number;
	};
	maxAvailableHeightPercent: {
		desktop: number;
		mobile: number;
	};
	priorityFirstImage?: boolean;
}

const {
	title,
	images,
	maxAvailableWidthPercent,
	maxAvailableHeightPercent,
	priorityFirstImage = false,
} = Astro.props;
const managedImageSizes = getManagedImageSizes(maxAvailableWidthPercent);
const carouselAspectRatio = getCarouselAspectRatio(images);
const carouselStyle = carouselAspectRatio
	? [
		`--image-carousel-aspect-ratio: ${carouselAspectRatio}`,
		`--image-carousel-width-from-height-desktop: ${carouselAspectRatio * maxAvailableHeightPercent.desktop}svh`,
		`--image-carousel-width-from-height-mobile: ${carouselAspectRatio * maxAvailableHeightPercent.mobile}svh`,
	].join('; ')
	: undefined;
---

<div class="managed-images" aria-label={`${projectConfig.locale.labels.images}: ${title}`}>
	<section
		class="managed-image-item image-carousel"
		data-carousel
		tabindex="0"
		role="group"
		aria-roledescription="carousel"
		aria-label={`${title}, ${projectConfig.locale.labels.imageCarousel}`}
		style={carouselStyle}
	>
		<div class="image-carousel-stage">
			<div class="image-carousel-viewport" data-carousel-viewport>
				<div class="image-carousel-slides">
					{images.map((image, imageIndex) => {
						const captionId = image.caption ? getCaptionId(image, 0, imageIndex) : undefined;

						return (
							<figure class="image-carousel-slide" data-carousel-slide>
								<div class="image-carousel-frame">
									<img
										{...getImageAttributes(image.src ?? image.image, managedImageSizes)}
										class:list={['managed-image', getImageClass(image)]}
										alt={image.alt ?? ''}
										aria-describedby={captionId}
										{...getImageLoadingProps(priorityFirstImage && imageIndex === 0)}
									/>
								</div>
							</figure>
						);
					})}
				</div>
			</div>
			<button
				class="image-carousel-button image-carousel-button-previous"
				type="button"
				data-carousel-previous
				aria-label={projectConfig.locale.labels.previousImage}
				title={projectConfig.locale.labels.previousImage}
			>
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="m15 18-6-6 6-6"></path>
				</svg>
			</button>
			<button
				class="image-carousel-button image-carousel-button-next"
				type="button"
				data-carousel-next
				aria-label={projectConfig.locale.labels.nextImage}
				title={projectConfig.locale.labels.nextImage}
			>
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="m9 18 6-6-6-6"></path>
				</svg>
			</button>
			<output class="image-carousel-position" data-carousel-position aria-live="polite">
				1 / {images.length}
			</output>
		</div>
		<div class="image-carousel-captions" data-carousel-captions>
			{images.map((image, imageIndex) => (
				image.caption && (
					<p
						class="image-meta image-carousel-caption"
						id={getCaptionId(image, 0, imageIndex)}
						data-carousel-caption
						data-carousel-caption-index={imageIndex}
					>
						<span class="image-details">
							<span>{image.caption}</span>
						</span>
					</p>
				)
			))}
		</div>
	</section>
</div>

<script>
	import EmblaCarousel from 'embla-carousel';

	const initializeCarousel = (carousel: HTMLElement) => {
		if (carousel.dataset.carouselInitialized === 'true') return;

		const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]');
		const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
		const position = carousel.querySelector<HTMLOutputElement>('[data-carousel-position]');
		const captions = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-caption]'));
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
		if (!viewport || !previous || !next || !position || slides.length < 2) return;

		let controlsTimeout: number | undefined;
		const showControls = () => {
			carousel.classList.add('is-interacting');
			window.clearTimeout(controlsTimeout);
			controlsTimeout = window.setTimeout(() => {
				carousel.classList.remove('is-interacting');
			}, 1600);
		};

		carousel.dataset.carouselInitialized = 'true';
		carousel.dataset.carouselReady = 'true';

		const embla = EmblaCarousel(viewport, {
			align: 'start',
			containScroll: false,
			loop: true,
		});
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const scrollPrevious = () => embla.scrollPrev(reducedMotion.matches);
		const scrollNext = () => embla.scrollNext(reducedMotion.matches);

		const update = () => {
			const activeIndex = embla.selectedScrollSnap();
			slides.forEach((slide, index) => {
				const isSelected = index === activeIndex;
				slide.classList.toggle('is-active', isSelected);
				slide.setAttribute('aria-hidden', String(!isSelected));
			});
			captions.forEach((caption) => {
				const isSelected = Number(caption.dataset.carouselCaptionIndex) === activeIndex;
				caption.classList.toggle('is-active', isSelected);
				caption.setAttribute('aria-hidden', String(!isSelected));
			});
			previous.disabled = false;
			next.disabled = false;
			position.textContent = `${activeIndex + 1} / ${slides.length}`;
		};

		previous.addEventListener('click', () => {
			showControls();
			scrollPrevious();
		});
		next.addEventListener('click', () => {
			showControls();
			scrollNext();
		});
		carousel.addEventListener('focusin', showControls);
		carousel.addEventListener('pointerdown', showControls);
		carousel.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				showControls();
				scrollPrevious();
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				showControls();
				scrollNext();
			}
		});
		embla.on('select', () => {
			showControls();
			update();
		});
		embla.on('reInit', update);
		update();
	};

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initializeCarousel);
</script>
