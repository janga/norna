---
import projectConfig from '../../scripts/lib/project-config.mjs';
import { withBasePath } from '../lib/basePath';
import type { SectionNavigation } from '../lib/sectionContent';
import {
	getFirstPageInNavigationNode,
	getListedSiteNavigationTree,
	type SiteNavigationEntry,
	type SiteNavigationNode,
} from '../lib/siteNavigation';
import type { SiteNode, SitePage } from '../lib/sitePages';
import DisplaySettings from './DisplaySettings.astro';
import NavigationPageTree from './NavigationPageTree.astro';
import SectionNavigationScript from './SectionNavigationScript.astro';

type FrameColors = {
	backgroundColor: string;
	textColor: string;
};

interface Props {
	logo?: {
		src: string;
		alt: string;
		height?: string;
	};
	currentPage: SitePage;
	navigationEntries: SiteNavigationEntry[];
	navigationMode: 'sections' | 'top' | 'tree';
	showTopNavigationSubmenus: boolean;
	hasNavigationRailFrame: boolean;
	frameColors: FrameColors;
	readerPreferences: {
		controls: {
			appearance: boolean;
			readingWidth: boolean;
			focusReading: boolean;
		};
		defaults: {
			appearance: 'system' | 'light' | 'dark';
			readingWidth: 'narrow' | 'standard' | 'wide';
			focusReading: 'off' | 'on';
		};
	};
}

const {
	logo,
	currentPage,
	navigationEntries,
	navigationMode,
	showTopNavigationSubmenus,
	hasNavigationRailFrame,
	frameColors,
	readerPreferences,
} = Astro.props;
const siteTopBackgroundColor = frameColors.backgroundColor === 'transparent'
	? 'var(--color-page)'
	: frameColors.backgroundColor;
const navigationStyle = [
	`--site-top-background-color: ${siteTopBackgroundColor}`,
	`--site-top-text-color: ${frameColors.textColor}`,
	...(logo?.height ? [`--site-brand-logo-height: ${logo.height}`] : []),
].join('; ');
const siteNavigationTree = getListedSiteNavigationTree(navigationEntries);
const topLevelNavigation = siteNavigationTree;
const showSiteNavigation = topLevelNavigation.some(({ node }) => !node.isHome);
const homeNode = navigationEntries.find(({ node }) => node.isHome)?.node;
const homePage = homeNode?.kind === 'page' ? homeNode : currentPage;
const currentPageNavigation = navigationEntries.find(({ node }) => node.kind === 'page' && node.pathname === currentPage.pathname);
const isCurrentPage = (page: SitePage) => page.pathname === currentPage.pathname;
const isCurrentBranch = (node: SiteNode) => currentPage.pageDirectory === node.pageDirectory
	|| currentPage.pageDirectory.startsWith(`${node.pageDirectory}/pages/`);
const pageHref = (page: SitePage) => withBasePath(projectConfig.site.basePath, page.pathname);
const getNavigationPage = (node: SiteNavigationNode) => getFirstPageInNavigationNode(node);
const hasSectionMenu = (pageSections: SectionNavigation[]) => pageSections.length > 1;
const showSinglePageTopLink = !showSiteNavigation;
const currentPageSectionCount = currentPageNavigation?.sections.length ?? 0;
const hasCurrentPageSectionMenu = Boolean(
	currentPageNavigation && (
		showSinglePageTopLink
			? currentPageSectionCount > 0
			: hasSectionMenu(currentPageNavigation.sections)
	),
);
const hasTreePageContents = Boolean(
	navigationMode === 'tree' && currentPageNavigation?.headings.length,
);
const showPageNavigation = Boolean(
	navigationMode !== 'tree'
	&& currentPageNavigation
	&& (showSinglePageTopLink || hasCurrentPageSectionMenu),
);
const showSinglePageTitleOnly = showSinglePageTopLink && currentPageSectionCount === 0;
const showMobileNavigation = showSiteNavigation || hasCurrentPageSectionMenu || hasTreePageContents;
const showReaderControls = Object.values(readerPreferences.controls).some(Boolean);
const showDesktopNavigationRow = showSiteNavigation || Boolean(logo) || showReaderControls;
const showNavigationRow = showMobileNavigation || showDesktopNavigationRow;
const needsNavigationScript = hasCurrentPageSectionMenu || hasTreePageContents || navigationMode === 'tree';
---

<a class="skip-link" href="#main-content">{projectConfig.locale.labels.skipToContent}</a>

<header
	class:list={['site-top', {
		'site-top-has-site-nav': showSiteNavigation,
		'site-top-has-navigation-row': showDesktopNavigationRow,
		'site-top-has-navigation-rail-frame': hasNavigationRailFrame,
	}]}
	data-navigation-mode={navigationMode}
	style={navigationStyle}
>
	{showNavigationRow && (
		<div class:list={['site-nav-row', { 'site-nav-row-mobile-only': !showDesktopNavigationRow }]}>
			{logo && (
				<div class="site-nav-leading">
					<a class="site-brand" href={pageHref(homePage)}>
						<img class="site-brand-logo" src={withBasePath(projectConfig.site.basePath, logo.src)} alt={logo.alt} />
					</a>
				</div>
			)}

			<div class="site-nav-actions">
				{showSiteNavigation && (
					<nav class="site-nav" aria-label={projectConfig.locale.labels.siteNavigation}>
					<ul>
					{topLevelNavigation.map((navigationNode) => {
						const destination = getNavigationPage(navigationNode);
						if (!destination) return null;
						const nodeIsCurrentPage = navigationNode.node.kind === 'page' && isCurrentPage(navigationNode.node);
						return (
							<li class:list={['site-nav-item', {
								'site-nav-item-has-submenu': showTopNavigationSubmenus && navigationNode.children.length > 0,
								'site-nav-item-current-branch': !nodeIsCurrentPage && isCurrentBranch(navigationNode.node),
							}]}>
								<a href={pageHref(destination)} aria-current={nodeIsCurrentPage ? 'page' : undefined}>
									{navigationNode.node.title}
								</a>
								{showTopNavigationSubmenus && navigationNode.children.length > 0 && (
									<div class="site-nav-submenu">
										<nav aria-label={`${navigationNode.node.title} ${projectConfig.locale.labels.siteNavigation}`}>
											<NavigationPageTree nodes={[navigationNode]} currentPage={currentPage} variant="submenu" />
										</nav>
									</div>
								)}
							</li>
						);
					})}
					</ul>
					</nav>
				)}

				{showReaderControls && (
					<DisplaySettings controls={readerPreferences.controls} defaults={readerPreferences.defaults} />
				)}

				{showMobileNavigation && <details class="mobile-nav-menu">
			<summary>
				<span>{projectConfig.locale.labels.navigationMenu}</span>
			</summary>
			<div class="mobile-nav-panel">
			<div class="mobile-site-nav" data-navigation-root={pageHref(homePage)}>
					{showSiteNavigation && (
						<nav class="mobile-nav-view" aria-label={projectConfig.locale.labels.siteNavigation}>
							<h2 tabindex="-1">{projectConfig.locale.labels.siteNavigation}</h2>
							<NavigationPageTree
								nodes={siteNavigationTree}
								currentPage={currentPage}
								variant="mobile"
								integratePageSections={navigationMode === 'tree'}
							/>
						</nav>
					)}

					{navigationMode !== 'tree' && hasCurrentPageSectionMenu && currentPageNavigation && (
						<nav class="mobile-nav-view" aria-label={projectConfig.locale.labels.pageNavigation}>
							{!showSinglePageTopLink && (
								<h2 tabindex="-1">{projectConfig.locale.labels.pageNavigation}</h2>
							)}
							<ul class="mobile-nav-sections">
								{showSinglePageTopLink && (
									<li class="mobile-nav-page-top-item">
										<a
											class="mobile-nav-destination mobile-nav-page-top"
											data-page-top
											href={pageHref(currentPage)}
										>
											{currentPage.title}
										</a>
									</li>
								)}
									{currentPageNavigation.sections.map((section) => (
										<li>
											<a class="mobile-nav-destination" href={`#${section.id}`}>{section.title}</a>
										</li>
								))}
							</ul>
						</nav>
					)}
				</div>
			</div>
				</details>}
			</div>
		</div>
	)}

	{showPageNavigation && currentPageNavigation && (
		<nav
			class:list={['page-nav', { 'page-nav-title-only': showSinglePageTitleOnly }]}
			aria-label={projectConfig.locale.labels.pageNavigation}
		>
			<div class="page-nav-inner">
				{!showSinglePageTopLink && (
					<span class="page-nav-label">{projectConfig.locale.labels.pageNavigation}</span>
				)}
				<ul>
					{showSinglePageTopLink && (
						<li class="page-nav-page-top-item">
							<a class="page-nav-page-top" data-page-top href={pageHref(currentPage)}>
								{currentPage.title}
							</a>
						</li>
					)}
					{currentPageNavigation.sections.map((section) => (
						<li>
							<a href={`#${section.id}`}>{section.title}</a>
						</li>
					))}
				</ul>
			</div>
		</nav>
	)}

</header>

{needsNavigationScript && <SectionNavigationScript />}
