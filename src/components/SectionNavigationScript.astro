<script>
	const siteTop = document.querySelector<HTMLElement>('.site-top');
	const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav-menu');
	const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(
		'.mobile-nav-sections a, .page-nav a',
	));
	const submenuItems = Array.from(document.querySelectorAll<HTMLElement>('.site-nav-item-has-submenu'));
	const mobileDestinationLinks = Array.from(mobileMenu?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-destination') ?? []);
	const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>(':scope > summary');

	const setAnchorOffset = () => {
		if (!siteTop) return;

		const offset = Math.ceil(siteTop.getBoundingClientRect().height);
		document.documentElement.style.setProperty('--site-top-anchor-offset', `${offset}px`);
	};

	const alignInitialHashTarget = () => {
		if (!window.location.hash) return;

		try {
			const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
			target?.scrollIntoView({ block: 'start' });
		} catch {
			// Invalid URL encoding is left to the browser's native hash handling.
		}
	};

	const getSamePageTarget = (link: HTMLAnchorElement) => {
		const linkUrl = new URL(link.href, window.location.href);
		if (linkUrl.pathname !== window.location.pathname || !linkUrl.hash) return undefined;

		try {
			return document.getElementById(decodeURIComponent(linkUrl.hash.slice(1))) ?? undefined;
		} catch {
			return undefined;
		}
	};

	const updateCurrentSection = () => {
		sectionLinks.forEach((link) => {
			const linkUrl = new URL(link.href, window.location.href);
			const isCurrent = linkUrl.pathname === window.location.pathname
				&& linkUrl.hash !== ''
				&& linkUrl.hash === window.location.hash;

			if (isCurrent) {
				link.setAttribute('aria-current', 'location');
			} else if (link.getAttribute('aria-current') === 'location') {
				link.removeAttribute('aria-current');
			}
		});
	};

	submenuItems.forEach((item) => {
		const resetDismissal = () => delete item.dataset.submenuDismissed;
		item.addEventListener('pointerleave', resetDismissal);
		item.querySelector<HTMLAnchorElement>(':scope > a')?.addEventListener('focus', resetDismissal);
	});

	if (mobileMenu) {
		mobileDestinationLinks.forEach((link) => {
			link.addEventListener('click', () => {
				mobileMenu.open = false;
			});
		});

		mobileMenu.addEventListener('toggle', () => {
			document.documentElement.classList.toggle('mobile-navigation-open', mobileMenu.open);
			if (mobileMenu.open) window.requestAnimationFrame(() => mobileMenu.querySelector<HTMLElement>('h2')?.focus());
		});

		mobileMenu.addEventListener('keydown', (event) => {
			if (!mobileMenu.open) return;

			if (event.key === 'Escape') {
				event.preventDefault();
				mobileMenu.open = false;
				mobileMenuSummary?.focus();
				return;
			}

			if (event.key !== 'Tab') return;

			const focusableElements = Array.from(mobileMenu.querySelectorAll<HTMLElement>(
				'summary, a[href]:not([hidden]), [tabindex]:not([tabindex="-1"]):not([hidden])',
			)).filter((element) => element.getClientRects().length > 0);
			const firstFocusable = focusableElements[0];
			const lastFocusable = focusableElements.at(-1);
			if (!firstFocusable || !lastFocusable) return;

			if (event.shiftKey && document.activeElement === firstFocusable) {
				event.preventDefault();
				lastFocusable.focus();
			} else if (!event.shiftKey && document.activeElement === lastFocusable) {
				event.preventDefault();
				firstFocusable.focus();
			}
		});
	}

	sectionLinks.forEach((link) => {
		link.addEventListener('click', (event) => {
			const target = getSamePageTarget(link);
			if (!target) return;

			if (mobileMenu) mobileMenu.open = false;
			link.closest<HTMLElement>('.site-nav-item')?.setAttribute('data-submenu-dismissed', 'true');

			window.requestAnimationFrame(() => {
				updateCurrentSection();
				if (event.detail > 0) {
					link.blur();
					return;
				}

				target.setAttribute('tabindex', '-1');
				target.focus({ preventScroll: true });
				target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
			});
		});
	});

	window.addEventListener('hashchange', updateCurrentSection);
	updateCurrentSection();

	setAnchorOffset();
	if (window.location.hash) window.requestAnimationFrame(alignInitialHashTarget);

	if (siteTop && 'ResizeObserver' in window) {
		new ResizeObserver(setAnchorOffset).observe(siteTop);
	}
</script>
