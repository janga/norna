<script>
	const siteTop = document.querySelector<HTMLElement>('.site-top');
	const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav-menu');
	const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(
		'.mobile-nav-sections a, .page-contents-links a, .page-nav a',
	));
	const submenuItems = Array.from(document.querySelectorAll<HTMLElement>('.site-nav-item-has-submenu'));
	const mobileDestinationLinks = Array.from(mobileMenu?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-destination') ?? []);
	const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>(':scope > summary');
	const sectionTrackingEnabled = document.documentElement.dataset.sectionTracking === 'enabled';
	const trackedHeadingIds = new Set(sectionLinks.flatMap((link) => {
		const linkUrl = new URL(link.href, window.location.href);
		if (linkUrl.pathname !== window.location.pathname || !linkUrl.hash) return [];

		try {
			return [decodeURIComponent(linkUrl.hash.slice(1))];
		} catch {
			return [];
		}
	}));
	const trackedHeadings = sectionTrackingEnabled
		? Array.from(document.querySelectorAll<HTMLElement>('.site-content h2[id], .site-content h3[id]'))
			.filter((heading) => trackedHeadingIds.has(heading.id))
		: [];
	let sectionTrackingFrame: number | undefined;
	let sectionTrackingPaused = false;
	let sectionTrackingResumeTimer: number | undefined;

	const resumeSectionTracking = () => {
		window.clearTimeout(sectionTrackingResumeTimer);
		window.removeEventListener('scrollend', resumeSectionTracking);
		sectionTrackingPaused = false;
		sectionTrackingResumeTimer = undefined;
	};

	const pauseSectionTrackingForAnchorNavigation = () => {
		if (!sectionTrackingEnabled) return;

		sectionTrackingPaused = true;
		if (sectionTrackingFrame !== undefined) {
			window.cancelAnimationFrame(sectionTrackingFrame);
			sectionTrackingFrame = undefined;
		}
		window.clearTimeout(sectionTrackingResumeTimer);
		window.removeEventListener('scrollend', resumeSectionTracking);
		if ('onscrollend' in document.documentElement) {
			window.addEventListener('scrollend', resumeSectionTracking, { once: true });
		}

		const scrollBehavior = getComputedStyle(document.documentElement).scrollBehavior;
		sectionTrackingResumeTimer = window.setTimeout(
			resumeSectionTracking,
			scrollBehavior === 'smooth' ? 2000 : 120,
		);
	};

	const setAnchorOffset = () => {
		if (!siteTop) return;

		const offset = Math.ceil(siteTop.getBoundingClientRect().height);
		document.documentElement.style.setProperty('--site-top-anchor-offset', `${offset}px`);
	};

	const alignInitialHashTarget = () => {
		if (!window.location.hash) return;

		try {
			const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
			target?.scrollIntoView({ block: 'start' });
		} catch {
			// Invalid URL encoding is left to the browser's native hash handling.
		}
	};

	const getSamePageTarget = (link: HTMLAnchorElement) => {
		const linkUrl = new URL(link.href, window.location.href);
		if (linkUrl.pathname !== window.location.pathname || !linkUrl.hash) return undefined;

		try {
			return document.getElementById(decodeURIComponent(linkUrl.hash.slice(1))) ?? undefined;
		} catch {
			return undefined;
		}
	};

	const updateCurrentSection = () => {
		sectionLinks.forEach((link) => {
			const linkUrl = new URL(link.href, window.location.href);
			const isPageTop = link.hasAttribute('data-page-top');
			const isCurrent = linkUrl.pathname === window.location.pathname && (
				isPageTop
					? window.location.hash === ''
					: linkUrl.hash !== '' && linkUrl.hash === window.location.hash
			);

			if (isCurrent) {
				link.setAttribute('aria-current', 'location');
			} else if (link.getAttribute('aria-current') === 'location') {
				link.removeAttribute('aria-current');
			}
		});
	};

	const updateReadingPosition = () => {
		sectionTrackingFrame = undefined;
		if (trackedHeadings.length === 0) return;

		let currentHeadingId: string | undefined = trackedHeadings[0]?.id;

		if (window.scrollY > 1) {
			const viewportHeight = window.innerHeight;
			const documentHeight = Math.max(
				document.body.scrollHeight,
				document.body.offsetHeight,
				document.documentElement.clientHeight,
				document.documentElement.scrollHeight,
				document.documentElement.offsetHeight,
			);
			const maximumScroll = Math.max(0, documentHeight - viewportHeight);
			const remainingScroll = Math.max(0, maximumScroll - window.scrollY);
			const normalReadingLine = Math.max(
				Math.ceil(siteTop?.getBoundingClientRect().bottom ?? 0) + 8,
				Math.round(viewportHeight / 2),
			);
			const terminalReadingLine = viewportHeight - remainingScroll;
			const readingLine = Math.min(
				viewportHeight,
				Math.max(normalReadingLine, terminalReadingLine),
			);

			for (const heading of trackedHeadings) {
				if (heading.getBoundingClientRect().top > readingLine) break;
				currentHeadingId = heading.id;
			}
		}

		sectionLinks.forEach((link) => {
			const target = getSamePageTarget(link);
			const isCurrent = target !== undefined && target.id === currentHeadingId;

			if (isCurrent) {
				link.setAttribute('aria-current', 'location');
			} else if (link.getAttribute('aria-current') === 'location') {
				link.removeAttribute('aria-current');
			}
		});
	};

	const scheduleReadingPositionUpdate = () => {
		if (!sectionTrackingEnabled || sectionTrackingPaused || sectionTrackingFrame !== undefined) return;
		sectionTrackingFrame = window.requestAnimationFrame(updateReadingPosition);
	};

	submenuItems.forEach((item) => {
		const resetDismissal = () => delete item.dataset.submenuDismissed;
		item.addEventListener('pointerleave', resetDismissal);
		item.querySelector<HTMLAnchorElement>(':scope > a')?.addEventListener('focus', resetDismissal);
	});

	if (mobileMenu) {
		mobileDestinationLinks.forEach((link) => {
			link.addEventListener('click', () => {
				mobileMenu.open = false;
			});
		});

		mobileMenu.addEventListener('toggle', () => {
			document.documentElement.classList.toggle('mobile-navigation-open', mobileMenu.open);
			if (mobileMenu.open) {
				window.requestAnimationFrame(() => (
					mobileMenu.querySelector<HTMLElement>('.mobile-nav-view h2, .mobile-nav-view a')?.focus()
				));
			}
		});

		mobileMenu.addEventListener('keydown', (event) => {
			if (!mobileMenu.open) return;

			if (event.key === 'Escape') {
				event.preventDefault();
				mobileMenu.open = false;
				mobileMenuSummary?.focus();
				return;
			}

			if (event.key !== 'Tab') return;

			const focusableElements = Array.from(mobileMenu.querySelectorAll<HTMLElement>(
				'summary, a[href]:not([hidden]), [tabindex]:not([tabindex="-1"]):not([hidden])',
			)).filter((element) => element.getClientRects().length > 0);
			const firstFocusable = focusableElements[0];
			const lastFocusable = focusableElements.at(-1);
			if (!firstFocusable || !lastFocusable) return;

			if (event.shiftKey && document.activeElement === firstFocusable) {
				event.preventDefault();
				lastFocusable.focus();
			} else if (!event.shiftKey && document.activeElement === lastFocusable) {
				event.preventDefault();
				firstFocusable.focus();
			}
		});
	}

	sectionLinks.forEach((link) => {
		link.addEventListener('click', (event) => {
			const target = getSamePageTarget(link);
			if (!target) return;

			pauseSectionTrackingForAnchorNavigation();
			if (mobileMenu) mobileMenu.open = false;
			link.closest<HTMLElement>('.site-nav-item')?.setAttribute('data-submenu-dismissed', 'true');

			window.requestAnimationFrame(() => {
				updateCurrentSection();
				if (event.detail > 0) {
					link.blur();
					return;
				}

				target.setAttribute('tabindex', '-1');
				target.focus({ preventScroll: true });
				target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
			});
		});
	});

	window.addEventListener('hashchange', () => {
		pauseSectionTrackingForAnchorNavigation();
		updateCurrentSection();
		scheduleReadingPositionUpdate();
	});
	if (window.location.hash) pauseSectionTrackingForAnchorNavigation();
	updateCurrentSection();
	if (sectionTrackingEnabled) {
		window.addEventListener('scroll', scheduleReadingPositionUpdate, { passive: true });
		window.addEventListener('resize', scheduleReadingPositionUpdate);
		scheduleReadingPositionUpdate();
	}

	setAnchorOffset();
	if (window.location.hash) window.requestAnimationFrame(alignInitialHashTarget);

	if (siteTop && 'ResizeObserver' in window) {
		new ResizeObserver(() => {
			setAnchorOffset();
			scheduleReadingPositionUpdate();
		}).observe(siteTop);
	}
</script>
