---
import projectConfig from '../../scripts/lib/project-config.mjs';
import { withBasePath } from '../lib/basePath';
import type { SiteNavigationNode } from '../lib/siteNavigation';
import type { SiteNode, SitePage } from '../lib/sitePages';
import PageContentsLinks from './PageContentsLinks.astro';

interface Props {
	nodes: SiteNavigationNode[];
	currentPage: SitePage;
	variant: 'mobile' | 'sidebar' | 'submenu';
	integratePageSections?: boolean;
}

const { nodes, currentPage, variant, integratePageSections = false } = Astro.props;
const pageHref = (page: SitePage) => withBasePath(projectConfig.site.basePath, page.pathname);
const hasBranch = (node: SiteNavigationNode) => node.children.length > 0;
const isCurrentPage = (page: SitePage) => page.pathname === currentPage.pathname;
const isCurrentBranch = (node: SiteNode) => (
	currentPage.pageDirectory === node.pageDirectory
	|| currentPage.pageDirectory.startsWith(`${node.pageDirectory}/pages/`)
);
const getBranchId = (node: SiteNode) => [
	'navigation',
	variant,
	node.pagePath || 'home',
	'children',
].join('-').replace(/[^a-z0-9-]+/gi, '-');
const hasPageSections = (node: SiteNavigationNode) => (
	node.node.kind === 'page' && node.headings.some((heading) => heading.depth === 2)
);
const hasPageDisclosure = (node: SiteNavigationNode) => hasBranch(node) || hasPageSections(node);
const usesPageDisclosure = (node: SiteNavigationNode) => (
	variant === 'sidebar'
		? hasBranch(node)
		: integratePageSections && hasPageDisclosure(node)
);
---

<ul class:list={['navigation-page-tree', `navigation-page-tree-${variant}`]}>
	{nodes.map((node) => (
		<li
			class:list={['navigation-page-node', {
				'navigation-page-node-category': node.node.kind === 'category',
				'navigation-page-node-current': node.node.kind === 'page' && isCurrentPage(node.node),
				'navigation-page-node-current-branch': isCurrentBranch(node.node),
			}]}
		>
			{node.node.kind === 'category' ? (
				<details
					class:list={[
						'navigation-page-branch',
						'navigation-page-disclosure',
						'navigation-category-disclosure',
						`navigation-page-disclosure-${variant}`,
					]}
					data-page-path={node.node.pagePath}
					data-current-branch={isCurrentBranch(node.node) ? 'true' : undefined}
					open={isCurrentBranch(node.node)}
				>
					<summary
						class="navigation-page-summary"
						aria-controls={getBranchId(node.node)}
					>
						<span class="navigation-page-summary-title">{node.node.title}</span>
						<span class="navigation-page-chevron" aria-hidden="true"></span>
					</summary>
					<div id={getBranchId(node.node)} class="navigation-page-branch-content">
						<Astro.self
							nodes={node.children}
							currentPage={currentPage}
							variant={variant}
							integratePageSections={integratePageSections}
						/>
					</div>
				</details>
			) : variant !== 'submenu' && usesPageDisclosure(node) ? (
				<details
					class:list={['navigation-page-branch', 'navigation-page-disclosure', `navigation-page-disclosure-${variant}`]}
					data-page-path={node.node.pagePath || '/'}
					data-current-branch={isCurrentBranch(node.node) ? 'true' : undefined}
					data-current-page={isCurrentPage(node.node) ? 'true' : undefined}
					data-has-sections={hasPageSections(node) ? 'true' : undefined}
					open={isCurrentBranch(node.node)}
				>
					<summary
						class="navigation-page-summary"
						aria-controls={getBranchId(node.node)}
					>
						<span class="navigation-page-summary-title">{node.node.title}</span>
						<span class="navigation-page-chevron" aria-hidden="true"></span>
					</summary>
					<a
						class:list={['navigation-page-open-link', { 'mobile-nav-destination': variant === 'mobile' }]}
						href={pageHref(node.node)}
						aria-current={isCurrentPage(node.node) ? 'page' : undefined}
					>
						{node.node.title}
					</a>
					<div id={getBranchId(node.node)} class="navigation-page-branch-content">
						{integratePageSections && hasPageSections(node) && (
							<nav
								class="navigation-page-sections"
								aria-label={`${projectConfig.locale.labels.pageNavigation}: ${node.node.title}`}
							>
								<PageContentsLinks
									headings={node.headings}
									variant={variant === 'mobile' ? 'mobile' : 'desktop'}
									pageHref={isCurrentPage(node.node) ? undefined : pageHref(node.node)}
								/>
							</nav>
						)}
						{hasBranch(node) && (
							<Astro.self
								nodes={node.children}
								currentPage={currentPage}
								variant={variant}
								integratePageSections={integratePageSections}
							/>
						)}
					</div>
				</details>
			) : variant !== 'submenu' ? (
				<>
					<a
						class:list={['navigation-page-link', { 'mobile-nav-destination': variant === 'mobile' }]}
						href={pageHref(node.node)}
						aria-current={isCurrentPage(node.node) ? 'page' : undefined}
					>
						{node.node.title}
					</a>
					{hasBranch(node) && (
						<details
							class="navigation-page-branch"
							data-page-path={node.node.pagePath || '/'}
							data-current-branch={isCurrentBranch(node.node) ? 'true' : undefined}
							open={isCurrentBranch(node.node)}
						>
							<summary aria-controls={getBranchId(node.node)}>
								<span class="visually-hidden">
									{projectConfig.locale.labels.navigationChildren}: {node.node.title}
								</span>
								<span aria-hidden="true"></span>
							</summary>
							<div id={getBranchId(node.node)} class="navigation-page-branch-content">
								<Astro.self
									nodes={node.children}
									currentPage={currentPage}
									variant={variant}
									integratePageSections={integratePageSections}
								/>
							</div>
						</details>
					)}
				</>
			) : (
				<>
					<a
						class="navigation-page-link"
						href={pageHref(node.node)}
						aria-current={isCurrentPage(node.node) ? 'page' : undefined}
					>
						{node.node.title}
					</a>
					{node.children.length > 0 && (
						<Astro.self nodes={node.children} currentPage={currentPage} variant={variant} />
					)}
				</>
			)}
		</li>
	))}
</ul>
