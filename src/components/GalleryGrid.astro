---
import projectConfig from '../../scripts/lib/project-config.mjs';
import { getImageAttributes } from '../lib/generatedImages';
import {
	getCaptionId,
	getGalleryImageSizes,
	getImageClass,
	getImageLoadingProps,
	type GalleryImage,
} from '../lib/galleryImages';

interface Props {
	title: string;
	images: GalleryImage[];
	maxAvailableWidthPercent: {
		desktop: number;
		mobile: number;
	};
	priorityFirstImage?: boolean;
}

const { title, images, maxAvailableWidthPercent, priorityFirstImage = false } = Astro.props;
const galleryImageSizes = getGalleryImageSizes(maxAvailableWidthPercent);
---

<div class="gallery" aria-label={`${projectConfig.locale.labels.gallery}: ${title}`}>
	{images.map((image, itemIndex) => {
		const isPriorityItem = priorityFirstImage && itemIndex === 0;
		const captionId = image.caption ? getCaptionId(image, itemIndex) : undefined;

		return (
			<figure class="gallery-item">
				<div class="gallery-image-frame">
					<img
						{...getImageAttributes(image.src ?? image.image, galleryImageSizes)}
						class:list={['gallery-image', getImageClass(image)]}
						alt={image.alt ?? ''}
						aria-describedby={captionId}
						{...getImageLoadingProps(isPriorityItem)}
					/>
				</div>
				{image.caption && (
					<figcaption class="gallery-meta" id={captionId}>
						<div class="gallery-details">
							<span>{image.caption}</span>
						</div>
					</figcaption>
				)}
			</figure>
		);
	})}
</div>
