---
import projectConfig from '../../scripts/lib/project-config.mjs';

interface Props {
	defaultMode: 'system' | 'light' | 'dark';
}

const { defaultMode } = Astro.props;
const labels = {
	system: projectConfig.locale.labels.colorModeSystem,
	light: projectConfig.locale.labels.colorModeLight,
	dark: projectConfig.locale.labels.colorModeDark,
};

const modes = ['system', 'light', 'dark'] as const;
---

<details
	class="color-mode-selector"
	data-color-mode-selector
	data-selected-mode={defaultMode}
>
	<summary
		aria-label={`${projectConfig.locale.labels.colorMode}: ${labels[defaultMode]}`}
		data-color-mode-trigger
	>
		<svg class="color-mode-icon color-mode-icon-system" aria-hidden="true" viewBox="0 0 24 24">
			<rect width="20" height="14" x="2" y="3" rx="2"></rect>
			<line x1="8" x2="16" y1="21" y2="21"></line>
			<line x1="12" x2="12" y1="17" y2="21"></line>
		</svg>
		<svg class="color-mode-icon color-mode-icon-light" aria-hidden="true" viewBox="0 0 24 24">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2"></path>
			<path d="M12 20v2"></path>
			<path d="m4.93 4.93 1.42 1.42"></path>
			<path d="m17.66 17.66 1.41 1.41"></path>
			<path d="M2 12h2"></path>
			<path d="M20 12h2"></path>
			<path d="m6.34 17.66-1.41 1.41"></path>
			<path d="m19.07 4.93-1.41 1.41"></path>
		</svg>
		<svg class="color-mode-icon color-mode-icon-dark" aria-hidden="true" viewBox="0 0 24 24">
			<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
		</svg>
	</summary>
	<div class="color-mode-menu">
		<p>{projectConfig.locale.labels.colorMode}</p>
		<ul>
			{modes.map((mode) => (
				<li>
					<button
						type="button"
						data-color-mode-option={mode}
						data-color-mode-label={labels[mode]}
						aria-pressed={defaultMode === mode ? 'true' : 'false'}
					>
						{mode === 'system' && (
							<svg class="color-mode-icon" aria-hidden="true" viewBox="0 0 24 24">
								<rect width="20" height="14" x="2" y="3" rx="2"></rect>
								<line x1="8" x2="16" y1="21" y2="21"></line>
								<line x1="12" x2="12" y1="17" y2="21"></line>
							</svg>
						)}
						{mode === 'light' && (
							<svg class="color-mode-icon" aria-hidden="true" viewBox="0 0 24 24">
								<circle cx="12" cy="12" r="4"></circle>
								<path d="M12 2v2"></path>
								<path d="M12 20v2"></path>
								<path d="m4.93 4.93 1.42 1.42"></path>
								<path d="m17.66 17.66 1.41 1.41"></path>
								<path d="M2 12h2"></path>
								<path d="M20 12h2"></path>
								<path d="m6.34 17.66-1.41 1.41"></path>
								<path d="m19.07 4.93-1.41 1.41"></path>
							</svg>
						)}
						{mode === 'dark' && (
							<svg class="color-mode-icon" aria-hidden="true" viewBox="0 0 24 24">
								<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
							</svg>
						)}
						<span>{labels[mode]}</span>
						<svg class="color-mode-check" aria-hidden="true" viewBox="0 0 24 24">
							<path d="m20 6-11 11-5-5"></path>
						</svg>
					</button>
				</li>
			))}
		</ul>
	</div>
</details>
