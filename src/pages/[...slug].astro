---
import { getCollection } from 'astro:content';
import { assertPageAliasModel, createPageAliasModel } from '../../scripts/lib/page-aliases.mjs';
import { getGeneratedSiteRoutes } from '../../scripts/lib/page-aliases.mjs';
import { getSitePublicFiles } from '../../scripts/lib/site-link-graph.mjs';
import projectConfig from '../../scripts/lib/project-config.mjs';
import PageAliasRedirect from '../components/PageAliasRedirect.astro';
import SearchPage from '../components/SearchPage.astro';
import SitePage from '../components/SitePage.astro';
import { getSiteModel, getSitePage, isHomePageEntry } from '../lib/sitePages';

export async function getStaticPaths() {
	const entries = await getCollection('site');
	const siteModel = await getSiteModel(entries);
	const aliasModel = assertPageAliasModel(createPageAliasModel({
		categories: siteModel.categories,
		pages: siteModel.pages,
		publicFiles: await getSitePublicFiles(),
		generatedRoutes: getGeneratedSiteRoutes({ searchEnabled: projectConfig.search.enabled }),
	}));
	const pagesByPathname = new Map(siteModel.pages.map((page) => [page.pathname, page]));

	const pagePaths = siteModel.pages
		.filter((page) => !page.isHome)
		.map((page) => ({
			params: { slug: page.pathSegment },
			props: { entry: page.entry },
		}));
	const aliasPaths = aliasModel.aliases.map((alias) => {
		const page = pagesByPathname.get(alias.targetPathname);
		if (!page) throw new Error(`Page alias "${alias.pathname}" has no target page ${alias.targetPathname}.`);

		return {
			params: { slug: alias.pathname.slice(1, -1) },
			props: {
				alias: {
					targetPathname: page.pathname,
					targetTitle: page.title,
				},
			},
		};
	});

	const searchPath = projectConfig.search.enabled
		? [{ params: { slug: 'search' }, props: { searchPage: true } }]
		: [];

	return [...pagePaths, ...aliasPaths, ...searchPath];
}

const { alias, entry, searchPage } = Astro.props;

if (!searchPage && !alias && (!entry || isHomePageEntry(entry))) {
	throw new Error('Page entry is missing.');
}

const currentPage = entry ? await getSitePage(entry) : null;

if (!searchPage && !alias && !currentPage?.pathSegment) {
	throw new Error(`Page "${entry.id}" needs a page id.`);
}
---

{searchPage
	? <SearchPage />
	: alias
	? <PageAliasRedirect targetPathname={alias.targetPathname} targetTitle={alias.targetTitle} />
	: <SitePage entry={entry} />}
