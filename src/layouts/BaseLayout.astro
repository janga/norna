---
import projectConfig from '../../scripts/lib/project-config.mjs';
import { getPresentationCssVariables } from '../../scripts/lib/presentation.mjs';
import { getIconLinks } from '../lib/sitePublicAssets';
import { withBasePath } from '../lib/basePath';
import '../styles/global.css';

type FrameColors = {
	backgroundColor: string;
	textColor: string;
};

type Presentation = {
	palette: {
		page: FrameColors;
	};
	paletteModes: Record<'light' | 'dark', {
		page: FrameColors;
		css: Record<string, string>;
	}>;
	colorMode: {
		default: 'system' | 'light' | 'dark';
		allowSelection: boolean;
	};
};
type VisualTheme = {
	layout: {
		gutter: { desktop: string; mobile: string };
		localNavigationGap: string;
		noteWidth: string;
		noteGap: string;
		pageWidth: string;
		spacing: {
			firstSectionTop: { desktop: string; mobile: string };
			blockGap: { desktop: string; mobile: string };
			headingToBlock: { desktop: string; mobile: string };
			imageGap: { desktop: string; mobile: string };
			sectionGap: { desktop: string; mobile: string };
			finalSectionBottom: { desktop: string; mobile: string };
		};
	};
	images: {
		width: string;
		maxAvailableWidthPercent: { desktop: number; mobile: number };
		maxAvailableHeightPercent: { desktop: number; mobile: number };
	};
	typography: { fontFamily: string };
	shape: {
		radiusSmall: string;
		radiusMedium: string;
		radiusLarge: string;
	};
};

interface Props {
	title: string;
	description?: string;
	presentation: Presentation;
	visualTheme: VisualTheme;
	frameColors: FrameColors;
	pathname?: string;
	footer?: {
		copyrightMessage?: string;
		buildInfo?: boolean;
	};
}

const {
	title,
	description,
	presentation,
	visualTheme,
	frameColors,
	pathname = '/',
	footer,
} = Astro.props;

const documentTitle = title;
const canonicalUrl = new URL(withBasePath(projectConfig.site.basePath, pathname), projectConfig.site.url).href;
const iconLinks = getIconLinks();
const scrollBehavior = projectConfig.navigation.scrollBehavior === 'smooth' ? 'smooth' : 'auto';
const formatPercent = (value: number) => `${value}%`;
const formatViewportHeightPercent = (value: number) => `${value}svh`;
const layoutSpacing = visualTheme.layout.spacing;
const documentStyle = [
	`scroll-behavior: ${scrollBehavior}`,
	...Object.entries(getPresentationCssVariables(presentation)).map(([name, value]) => `${name}: ${value}`),
	`--font-sans: ${visualTheme.typography.fontFamily}`,
	`--shape-radius-small: ${visualTheme.shape.radiusSmall}`,
	`--shape-radius-medium: ${visualTheme.shape.radiusMedium}`,
	`--shape-radius-large: ${visualTheme.shape.radiusLarge}`,
	`--page-width: ${visualTheme.layout.pageWidth}`,
	`--local-navigation-gap: ${visualTheme.layout.localNavigationGap}`,
	`--section-note-width: ${visualTheme.layout.noteWidth}`,
	`--section-note-gap: ${visualTheme.layout.noteGap}`,
	`--content-gutter-desktop: ${visualTheme.layout.gutter.desktop}`,
	`--content-gutter-mobile: ${visualTheme.layout.gutter.mobile}`,
	`--space-nav-to-first-section-desktop: ${layoutSpacing.firstSectionTop.desktop}`,
	`--space-nav-to-first-section-mobile: ${layoutSpacing.firstSectionTop.mobile}`,
	`--space-content-block-gap-desktop: ${layoutSpacing.blockGap.desktop}`,
	`--space-content-block-gap-mobile: ${layoutSpacing.blockGap.mobile}`,
	`--space-heading-to-block-desktop: ${layoutSpacing.headingToBlock.desktop}`,
	`--space-heading-to-block-mobile: ${layoutSpacing.headingToBlock.mobile}`,
	`--space-image-item-desktop: ${layoutSpacing.imageGap.desktop}`,
	`--space-image-item-mobile: ${layoutSpacing.imageGap.mobile}`,
	`--space-section-to-section-desktop: ${layoutSpacing.sectionGap.desktop}`,
	`--space-section-to-section-mobile: ${layoutSpacing.sectionGap.mobile}`,
	`--space-final-section-bottom-desktop: ${layoutSpacing.finalSectionBottom.desktop}`,
	`--space-final-section-bottom-mobile: ${layoutSpacing.finalSectionBottom.mobile}`,
	`--image-width: ${visualTheme.images.width}`,
	`--image-max-available-width-desktop: ${formatPercent(visualTheme.images.maxAvailableWidthPercent.desktop)}`,
	`--image-max-available-width-mobile: ${formatPercent(visualTheme.images.maxAvailableWidthPercent.mobile)}`,
	`--image-max-height-desktop: ${formatViewportHeightPercent(visualTheme.images.maxAvailableHeightPercent.desktop)}`,
	`--image-max-height-mobile: ${formatViewportHeightPercent(visualTheme.images.maxAvailableHeightPercent.mobile)}`,
].join('; ');
const { buildInfo, copyrightMessage } = footer ?? {};
const showBuildInfo = buildInfo === true;
const buildTime = showBuildInfo
	? new Intl.DateTimeFormat(projectConfig.locale.lang, {
		dateStyle: 'short',
		timeStyle: 'short',
		timeZone: 'UTC',
	}).format(new Date())
	: null;
const showFooter = Boolean(copyrightMessage || showBuildInfo);
const footerStyle = [
	`--site-footer-background-color: ${frameColors.backgroundColor}`,
	`--site-footer-text-color: ${frameColors.textColor}`,
].join('; ');
const colorModeCookieName = 'norna-color-mode';
const colorModeCookiePath = projectConfig.site.basePath;
const colorModeScript = presentation.colorMode.allowSelection
	? `(() => {
	const root = document.documentElement;
	const cookieName = ${JSON.stringify(colorModeCookieName)};
	const cookiePath = ${JSON.stringify(colorModeCookiePath)};
	const allowedModes = new Set(['system', 'light', 'dark']);
	const readSavedMode = () => {
		const prefix = encodeURIComponent(cookieName) + '=';
		const cookie = document.cookie.split('; ').find((part) => part.startsWith(prefix));
		if (!cookie) return null;
		const mode = decodeURIComponent(cookie.slice(prefix.length));
		return allowedModes.has(mode) ? mode : null;
	};
	const saveMode = (mode) => {
		try {
			const secure = location.protocol === 'https:' ? '; Secure' : '';
			document.cookie = encodeURIComponent(cookieName) + '=' + encodeURIComponent(mode)
				+ '; Path=' + cookiePath + '; Max-Age=31536000; SameSite=Lax' + secure;
		} catch {}
	};
	const applyMode = (mode, persist = false) => {
		const nextMode = allowedModes.has(mode) ? mode : ${JSON.stringify(presentation.colorMode.default)};
		root.dataset.colorMode = nextMode;
		if (persist) saveMode(nextMode);
		document.querySelectorAll('[data-color-mode-selector]').forEach((selector) => {
			selector.dataset.selectedMode = nextMode;
			selector.querySelectorAll('[data-color-mode-option]').forEach((option) => {
				option.setAttribute('aria-pressed', String(option.dataset.colorModeOption === nextMode));
			});
			const selectedOption = selector.querySelector('[data-color-mode-option="' + nextMode + '"]');
			const trigger = selector.querySelector('[data-color-mode-trigger]');
			if (trigger && selectedOption) {
				trigger.setAttribute('aria-label', ${JSON.stringify(projectConfig.locale.labels.colorMode)} + ': ' + selectedOption.dataset.colorModeLabel);
			}
			if (persist) selector.removeAttribute('open');
		});
		requestAnimationFrame(() => {
			const themeColor = getComputedStyle(root).getPropertyValue('--color-page').trim();
			if (themeColor) document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.content = themeColor);
		});
	};
	applyMode(readSavedMode() ?? root.dataset.colorMode);
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('[data-color-mode-selector]').forEach((selector) => {
			selector.querySelectorAll('[data-color-mode-option]').forEach((option) => {
				option.addEventListener('click', () => applyMode(option.dataset.colorModeOption, true));
			});
		});
		applyMode(root.dataset.colorMode);
	});
	document.addEventListener('click', (event) => {
		document.querySelectorAll('[data-color-mode-selector][open]').forEach((selector) => {
			if (!selector.contains(event.target)) selector.removeAttribute('open');
		});
	});
	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
		if (root.dataset.colorMode === 'system') applyMode('system');
	});
})();`
	: null;
---

<!doctype html>
<html lang={projectConfig.locale.lang} data-color-mode={presentation.colorMode.default} style={documentStyle}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="format-detection" content="telephone=no" />
		{description && <meta name="description" content={description} />}
		<meta name="theme-color" content={presentation.palette.page.backgroundColor} />
		{colorModeScript && <script is:inline set:html={colorModeScript} />}
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		{iconLinks.map((iconLink) => (
			<link
				rel={iconLink.rel}
				type={iconLink.type}
				sizes={iconLink.sizes}
				href={iconLink.href}
			/>
		))}
		<title>{documentTitle}</title>
	</head>
	<body>
		<slot />
		{showFooter && (
			<footer class="site-footer" style={footerStyle}>
				<p>
					{copyrightMessage}
					{showBuildInfo && <span>{projectConfig.locale.labels.built} {buildTime}</span>}
				</p>
			</footer>
		)}
	</body>
</html>
