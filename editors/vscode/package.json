{
  "name": "norna-vscode",
  "displayName": "Norna",
  "description": "Project-local IntelliSense for Norna configuration, Markdown blocks, notes, and managed images.",
  "version": "0.1.0",
  "publisher": "janga",
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#27364a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janga/norna.git"
  },
  "bugs": {
    "url": "https://github.com/janga/norna/issues"
  },
  "homepage": "https://janga.github.io/norna/",
  "keywords": [
    "norna",
    "markdown",
    "static site generator",
    "yaml",
    "images"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Norna loads schema and editor support from the @janga/norna package installed by the open project."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Norna editor support requires the project's local files and installed package."
    }
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:yaml",
    "onCommand:nornaEditor.showStatus",
    "onCommand:nornaEditor.refresh"
  ],
  "main": "./dist/extension.cjs",
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nornaEditor.showStatus",
        "title": "Norna: Show IntelliSense Status"
      },
      {
        "command": "nornaEditor.refresh",
        "title": "Norna: Refresh IntelliSense"
      }
    ]
  },
  "scripts": {
    "audit:runtime": "npm audit --omit=dev",
    "build": "esbuild extension.cjs --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "check": "npm run build && node --check extension.cjs && node --check norna-project.cjs && node --check yaml-schema-completions.cjs && node --check dist/extension.cjs && node test/package-contract.mjs",
    "package": "vsce package --out norna-vscode.vsix",
    "publish:marketplace": "vsce publish",
    "vscode:prepublish": "npm run build",
    "test:integration": "node test/run-integration.mjs",
    "test:integration:minimum": "node test/run-integration.mjs --version 1.96.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
