{
  "name": "norna-vscode",
  "displayName": "Norna",
  "description": "A site tree and project-local IntelliSense for Norna pages, configuration, Markdown blocks, notes, and managed images.",
  "version": "0.13.1",
  "publisher": "janga",
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#27364a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janga/norna.git"
  },
  "bugs": {
    "url": "https://github.com/janga/norna/issues"
  },
  "homepage": "https://janga.github.io/norna/",
  "keywords": [
    "norna",
    "markdown",
    "static site generator",
    "yaml",
    "images"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Norna loads schema and editor support from the @janga/norna package installed by the open project."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Norna editor support requires the project's local files and installed package."
    }
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:yaml",
    "onCommand:nornaEditor.showStatus",
    "onCommand:nornaEditor.refresh",
    "onView:nornaSiteTree"
  ],
  "main": "./dist/extension.cjs",
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nornaEditor.showStatus",
        "title": "Norna: Show IntelliSense Status"
      },
      {
        "command": "nornaEditor.refresh",
        "title": "Norna: Refresh IntelliSense"
      },
      {
        "command": "nornaEditor.openSiteNode",
        "title": "Norna: Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "nornaEditor.addPage",
        "title": "Norna: Add Page\u2026",
        "icon": "$(add)"
      },
      {
        "command": "nornaEditor.newPage",
        "title": "Norna: New Page\u2026",
        "icon": "$(new-file)"
      },
      {
        "command": "nornaEditor.pageInformation",
        "title": "Properties\u2026",
        "icon": "$(edit)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.refreshSiteTree",
        "title": "Norna: Refresh Site Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "nornaEditor.chooseSite",
        "title": "Norna: Choose Site\u2026",
        "icon": "$(globe)"
      },
      {
        "command": "nornaEditor.addToPage",
        "title": "Norna: Add\u2026",
        "icon": "$(add)"
      },
      {
        "command": "nornaEditor.addChildPage",
        "title": "Add Page\u2026",
        "icon": "$(add)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.movePage",
        "title": "Move\u2026",
        "icon": "$(move)",
        "enablement": "!nornaSiteTree.moveActive",
        "category": "Norna"
      },
      {
        "command": "nornaEditor.cancelMove",
        "title": "Norna: Cancel Page Move",
        "icon": "$(close)"
      },
      {
        "command": "nornaEditor.placeMoveBefore",
        "title": "Place Moving Page Before This Page"
      },
      {
        "command": "nornaEditor.placeMoveAfter",
        "title": "Place Moving Page After This Page"
      },
      {
        "command": "nornaEditor.placeMoveFirst",
        "title": "Place Moving Page as First Child"
      },
      {
        "command": "nornaEditor.placeMoveLast",
        "title": "Place Moving Page as Last Child"
      },
      {
        "command": "nornaEditor.acceptMovePreview",
        "title": "Complete Page Move\u2026"
      },
      {
        "command": "nornaEditor.importImage",
        "title": "Add Images\u2026",
        "icon": "$(add)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.insertImage",
        "title": "Insert Image in Page\u2026",
        "icon": "$(add)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.replaceImage",
        "title": "Replace\u2026",
        "icon": "$(replace)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.removeImage",
        "title": "Delete\u2026",
        "icon": "$(trash)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.removePage",
        "title": "Delete\u2026",
        "icon": "$(trash)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addressesAndLinks",
        "title": "Norna: Addresses and Links\u2026",
        "icon": "$(link)"
      },
      {
        "command": "nornaEditor.incomingLinks",
        "title": "References\u2026",
        "icon": "$(references)",
        "category": "Norna"
      },
      {
        "command": "nornaEditor.removeFile",
        "title": "Delete\u2026",
        "icon": "$(trash)",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addContent",
        "title": "Page Content\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addPageTheme",
        "title": "Page Theme",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addTreeTheme",
        "title": "Branch Theme",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addSettings",
        "title": "Site Settings\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addSharedContent",
        "title": "Shared Content",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.newPublicFile",
        "title": "New File\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addPublicFiles",
        "title": "Add Files\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.newPublicFolder",
        "title": "New Folder\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.renamePage",
        "title": "Rename\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.renameResource",
        "title": "Rename\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.replacePublicFile",
        "title": "Replace\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.moveResource",
        "title": "Move\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.copyPageLink",
        "title": "Copy Link",
        "category": "Norna"
      },
      {
        "command": "nornaEditor.copyResourceLink",
        "title": "Copy Link",
        "category": "Norna"
      },
      {
        "command": "nornaEditor.resourceReferences",
        "title": "References\u2026",
        "category": "Norna"
      },
      {
        "command": "nornaEditor.removeFolder",
        "title": "Delete\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addSitePublicFiles",
        "title": "Add Public Files\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addSiteConfiguration",
        "title": "Add Site Configuration\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.siteTreeHelp",
        "title": "Site Tree Help",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.addAttachments",
        "title": "Add Attachments\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.insertAttachment",
        "title": "Insert Link in Page\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.replaceAttachment",
        "title": "Replace\u2026",
        "category": "Norna",
        "enablement": "!nornaSiteTree.moveActive"
      },
      {
        "command": "nornaEditor.previewPage",
        "title": "Preview Page",
        "category": "Norna",
        "enablement": "nornaSiteTree.hasActiveSite"
      },
      {
        "command": "nornaEditor.previewSite",
        "title": "Preview Site",
        "category": "Norna",
        "enablement": "nornaSiteTree.hasActiveSite"
      },
      {
        "command": "nornaEditor.stopPreview",
        "title": "Stop Preview Server",
        "category": "Norna",
        "enablement": "nornaSiteTree.previewRunning"
      },
      {
        "command": "nornaEditor.showPreviewLog",
        "title": "Show Preview Log",
        "category": "Norna",
        "enablement": "nornaSiteTree.hasActiveSite"
      },
      {
        "command": "nornaEditor.toggleUrlPaths",
        "title": "Show URL paths",
        "category": "Norna",
        "toggled": "nornaSiteTree.showUrlPaths"
      },
      {
        "command": "nornaEditor.copyFolderPath",
        "title": "Copy Folder Path",
        "category": "Norna"
      }
    ],
    "views": {
      "norna": [
        {
          "id": "nornaSiteTree",
          "name": "Site Tree",
          "icon": "$(list-tree)",
          "contextualTitle": "Norna"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "nornaEditor.chooseSite",
          "when": "view == nornaSiteTree && nornaSiteTree.hasMultipleSites && !nornaSiteTree.moveActive",
          "group": "navigation@0"
        },
        {
          "command": "nornaEditor.refreshSiteTree",
          "when": "view == nornaSiteTree && !nornaSiteTree.moveActive",
          "group": "maintenance"
        },
        {
          "command": "nornaEditor.addSiteConfiguration",
          "when": "view == nornaSiteTree && nornaSiteTree.resourceActions && !nornaSiteTree.moveActive",
          "group": "1_site@0"
        },
        {
          "command": "nornaEditor.addSitePublicFiles",
          "when": "view == nornaSiteTree && nornaSiteTree.resourceActions && !nornaSiteTree.moveActive",
          "group": "1_site@1"
        },
        {
          "command": "nornaEditor.siteTreeHelp",
          "when": "view == nornaSiteTree",
          "group": "help"
        },
        {
          "command": "nornaEditor.previewSite",
          "when": "view == nornaSiteTree && nornaSiteTree.hasActiveSite",
          "group": "3_preview@0"
        },
        {
          "command": "nornaEditor.stopPreview",
          "when": "view == nornaSiteTree && nornaSiteTree.hasActiveSite",
          "group": "3_preview@1"
        },
        {
          "command": "nornaEditor.showPreviewLog",
          "when": "view == nornaSiteTree && nornaSiteTree.hasActiveSite",
          "group": "3_preview@2"
        },
        {
          "command": "nornaEditor.toggleUrlPaths",
          "when": "view == nornaSiteTree",
          "group": "2_display@1"
        }
      ],
      "view/item/context": [
        {
          "command": "nornaEditor.cancelMove",
          "when": "view == nornaSiteTree && viewItem == nornaMoveSource",
          "group": "0_move@1"
        },
        {
          "command": "nornaEditor.placeMoveBefore",
          "when": "view == nornaSiteTree && nornaSiteTree.moveActive && viewItem =~ /^nornaPage(;|$)/",
          "group": "0_move@1"
        },
        {
          "command": "nornaEditor.placeMoveAfter",
          "when": "view == nornaSiteTree && nornaSiteTree.moveActive && viewItem =~ /^nornaPage(;|$)/",
          "group": "0_move@2"
        },
        {
          "command": "nornaEditor.placeMoveFirst",
          "when": "view == nornaSiteTree && nornaSiteTree.moveActive && viewItem =~ /^norna(Home|Page)(;|$)/",
          "group": "0_move@3"
        },
        {
          "command": "nornaEditor.placeMoveLast",
          "when": "view == nornaSiteTree && nornaSiteTree.moveActive && viewItem =~ /^norna(Home|Page)(;|$)/",
          "group": "0_move@4"
        },
        {
          "command": "nornaEditor.acceptMovePreview",
          "when": "view == nornaSiteTree && viewItem == nornaMovePreview",
          "group": "0_move@1"
        },
        {
          "command": "nornaEditor.addChildPage",
          "when": "view == nornaSiteTree && viewItem =~ /;addPage;/ && viewItem =~ /^norna(Pages|Images);/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.importImage",
          "when": "view == nornaSiteTree && viewItem =~ /;addImages;/ && viewItem =~ /^norna(Pages|Images);/",
          "group": "1_add@2"
        },
        {
          "command": "nornaEditor.newPublicFile",
          "when": "view == nornaSiteTree && viewItem =~ /;newPublicFile;/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.addPublicFiles",
          "when": "view == nornaSiteTree && viewItem =~ /;addPublicFiles;/",
          "group": "1_add@2"
        },
        {
          "command": "nornaEditor.newPublicFolder",
          "when": "view == nornaSiteTree && viewItem =~ /;newPublicFolder;/",
          "group": "1_add@3"
        },
        {
          "command": "nornaEditor.insertImage",
          "when": "view == nornaSiteTree && viewItem =~ /;insertImage;/",
          "group": "2_edit@1"
        },
        {
          "command": "nornaEditor.renamePage",
          "when": "view == nornaSiteTree && viewItem =~ /;renamePage;/",
          "group": "2_edit@2"
        },
        {
          "command": "nornaEditor.renameResource",
          "when": "view == nornaSiteTree && viewItem =~ /;renameResource;/",
          "group": "2_edit@2"
        },
        {
          "command": "nornaEditor.pageInformation",
          "when": "view == nornaSiteTree && viewItem =~ /;properties;/",
          "group": "2_edit@3"
        },
        {
          "command": "nornaEditor.replaceImage",
          "when": "view == nornaSiteTree && viewItem =~ /;replaceImage;/",
          "group": "2_edit@3"
        },
        {
          "command": "nornaEditor.replacePublicFile",
          "when": "view == nornaSiteTree && viewItem =~ /;replacePublicFile;/",
          "group": "2_edit@3"
        },
        {
          "command": "nornaEditor.movePage",
          "when": "view == nornaSiteTree && viewItem =~ /;movePage;/",
          "group": "3_organize@1"
        },
        {
          "command": "nornaEditor.moveResource",
          "when": "view == nornaSiteTree && viewItem =~ /;moveResource;/",
          "group": "3_organize@1"
        },
        {
          "command": "nornaEditor.copyPageLink",
          "when": "view == nornaSiteTree && viewItem =~ /;copyPageLink;/",
          "group": "4_inspect@1"
        },
        {
          "command": "nornaEditor.copyResourceLink",
          "when": "view == nornaSiteTree && viewItem =~ /;copyResourceLink;/",
          "group": "4_inspect@1"
        },
        {
          "command": "nornaEditor.incomingLinks",
          "when": "view == nornaSiteTree && viewItem =~ /;pageReferences;/",
          "group": "4_inspect@2"
        },
        {
          "command": "nornaEditor.resourceReferences",
          "when": "view == nornaSiteTree && viewItem =~ /;resourceReferences;/",
          "group": "4_inspect@2"
        },
        {
          "command": "nornaEditor.removePage",
          "when": "view == nornaSiteTree && viewItem =~ /;deletePage;/",
          "group": "5_delete@1"
        },
        {
          "command": "nornaEditor.removeImage",
          "when": "view == nornaSiteTree && viewItem =~ /;deleteImage;/",
          "group": "5_delete@1"
        },
        {
          "command": "nornaEditor.removeFile",
          "when": "view == nornaSiteTree && viewItem =~ /;deleteFile;/",
          "group": "5_delete@1"
        },
        {
          "command": "nornaEditor.removeFolder",
          "when": "view == nornaSiteTree && viewItem =~ /;deleteFolder;/",
          "group": "5_delete@1"
        },
        {
          "submenu": "nornaSiteTree.add",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/ && viewItem =~ /;(addPage|addImages|add_[a-z_]+);/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.newPage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Home|Page|Site)$/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.pageInformation",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Home|Page)$/",
          "group": "2_edit@2"
        },
        {
          "command": "nornaEditor.incomingLinks",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Home|Page)$/",
          "group": "4_inspect@1"
        },
        {
          "command": "nornaEditor.importImage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Home|Page|Images)$/",
          "group": "1_add@2"
        },
        {
          "command": "nornaEditor.insertImage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Image)$/",
          "group": "2_edit@1"
        },
        {
          "command": "nornaEditor.replaceImage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Image)$/",
          "group": "2_edit@3"
        },
        {
          "command": "nornaEditor.removeImage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Image)$/",
          "group": "5_delete@1"
        },
        {
          "command": "nornaEditor.removePage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Page)$/",
          "group": "5_delete@1"
        },
        {
          "command": "nornaEditor.removeFile",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(OptionalFile)$/",
          "group": "5_delete@1"
        },
        {
          "command": "nornaEditor.addToPage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Incomplete|Configuration)$/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.movePage",
          "when": "view == nornaSiteTree && viewItem == nornaPage",
          "group": "3_organize@1"
        },
        {
          "command": "nornaEditor.addPage",
          "when": "view == nornaSiteTree && viewItem == nornaPages",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.addAttachments",
          "when": "view == nornaSiteTree && viewItem =~ /;addAttachments;/ && viewItem =~ /^nornaDirectory;/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.insertAttachment",
          "when": "view == nornaSiteTree && viewItem =~ /;insertAttachment;/",
          "group": "2_edit@1"
        },
        {
          "command": "nornaEditor.replaceAttachment",
          "when": "view == nornaSiteTree && viewItem =~ /;replaceAttachment;/",
          "group": "2_edit@3"
        },
        {
          "command": "nornaEditor.previewPage",
          "when": "view == nornaSiteTree && viewItem =~ /^norna(Home|Page);/",
          "group": "3_preview@1"
        },
        {
          "command": "nornaEditor.copyFolderPath",
          "when": "view == nornaSiteTree && (viewItem =~ /;copyFolderPath;/ || viewItem == nornaMoveSource)",
          "group": "4_inspect@3"
        }
      ],
      "commandPalette": [
        {
          "command": "nornaEditor.openSiteNode",
          "when": "false"
        },
        {
          "command": "nornaEditor.addPage",
          "when": "false"
        },
        {
          "command": "nornaEditor.addContent",
          "when": "false"
        },
        {
          "command": "nornaEditor.addPageTheme",
          "when": "false"
        },
        {
          "command": "nornaEditor.addTreeTheme",
          "when": "false"
        },
        {
          "command": "nornaEditor.addSettings",
          "when": "false"
        },
        {
          "command": "nornaEditor.addSharedContent",
          "when": "false"
        },
        {
          "command": "nornaEditor.addChildPage",
          "when": "false"
        },
        {
          "command": "nornaEditor.renameResource",
          "when": "false"
        },
        {
          "command": "nornaEditor.renamePage",
          "when": "false"
        },
        {
          "command": "nornaEditor.moveResource",
          "when": "false"
        },
        {
          "command": "nornaEditor.removeFolder",
          "when": "false"
        },
        {
          "command": "nornaEditor.removeImage",
          "when": "false"
        },
        {
          "command": "nornaEditor.removeFile",
          "when": "false"
        },
        {
          "command": "nornaEditor.removePage",
          "when": "false"
        },
        {
          "command": "nornaEditor.replaceImage",
          "when": "false"
        },
        {
          "command": "nornaEditor.replacePublicFile",
          "when": "false"
        },
        {
          "command": "nornaEditor.copyResourceLink",
          "when": "false"
        },
        {
          "command": "nornaEditor.resourceReferences",
          "when": "false"
        },
        {
          "command": "nornaEditor.addAttachments",
          "when": "false"
        },
        {
          "command": "nornaEditor.insertAttachment",
          "when": "false"
        },
        {
          "command": "nornaEditor.replaceAttachment",
          "when": "false"
        },
        {
          "command": "nornaEditor.copyFolderPath",
          "when": "false"
        }
      ],
      "nornaSiteTree.add": [
        {
          "command": "nornaEditor.addChildPage",
          "when": "view == nornaSiteTree && viewItem =~ /;addPage;/ && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.importImage",
          "when": "view == nornaSiteTree && viewItem =~ /;addImages;/ && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/",
          "group": "1_add@2"
        },
        {
          "command": "nornaEditor.addContent",
          "when": "view == nornaSiteTree && viewItem =~ /;add_content_md;/ && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/",
          "group": "1_add@0"
        },
        {
          "command": "nornaEditor.addPageTheme",
          "when": "view == nornaSiteTree && viewItem =~ /;add_page_theme_yaml;/ && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/",
          "group": "1_add@3"
        },
        {
          "command": "nornaEditor.addTreeTheme",
          "when": "view == nornaSiteTree && viewItem =~ /;add_tree_theme_yaml;/ && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/",
          "group": "1_add@4"
        },
        {
          "command": "nornaEditor.addSettings",
          "when": "view == nornaSiteTree && viewItem =~ /;add_settings_yaml;/ && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/",
          "group": "1_add@1"
        },
        {
          "command": "nornaEditor.addSharedContent",
          "when": "view == nornaSiteTree && viewItem =~ /;add_shared_content_yaml;/ && viewItem =~ /^norna(Home|Page|Incomplete|Configuration);/",
          "group": "1_add@2"
        },
        {
          "command": "nornaEditor.addAttachments",
          "when": "view == nornaSiteTree && viewItem =~ /;addAttachments;/ && viewItem =~ /^norna(Home|Page);/",
          "group": "1_add@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "norna",
          "title": "Norna",
          "icon": "media/norna.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nornaSiteTree",
        "contents": "Choose a site to show its pages and files.\n[Choose Site\u2026](command:nornaEditor.chooseSite)",
        "when": "nornaSiteTree.hasMultipleSites && !nornaSiteTree.hasActiveSite"
      }
    ],
    "submenus": [
      {
        "id": "nornaSiteTree.add",
        "label": "Add"
      }
    ]
  },
  "scripts": {
    "audit:runtime": "npm audit --omit=dev",
    "build": "esbuild extension.cjs --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "check": "npm run build && node --check extension.cjs && node --check site-tree.cjs && node --check site-file-actions.cjs && node --check site-address-actions.cjs && node --check site-link-review.cjs && node --check norna-project.cjs && node --check yaml-schema-completions.cjs && node --check dist/extension.cjs && node test/markdown-contract.mjs && node test/site-tree-contract.mjs && node --test test/page-move-confirmation-contract.mjs && node test/page-form-contract.mjs && node --test test/page-address-form-contract.mjs && node test/site-file-actions-contract.mjs && node test/site-address-actions-contract.mjs && node --test test/site-resource-actions-contract.mjs && node --test test/attachment-actions-contract.mjs && node test/package-contract.mjs",
    "package": "vsce package --out norna-vscode.vsix",
    "publish:marketplace": "vsce publish",
    "vscode:prepublish": "npm run build",
    "test:attachment-form": "node --test test/attachment-form-browser.mjs",
    "test:integration": "node test/run-integration.mjs",
    "test:integration:minimum": "node test/run-integration.mjs --version 1.96.0",
    "test:page-address-form": "node --test test/page-address-form-browser.mjs",
    "test:page-move-confirmation": "node --test test/page-move-confirmation-browser.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
